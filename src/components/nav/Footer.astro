---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <span class="kerb" aria-hidden="true"></span>
  <div class="container footer-inner">
    <div class="footer-cols">
      <div class="col">
        <p class="eyebrow">About</p>
        <p class="muted">An independent, educational guide to Formula 1 for newcomers and casual fans leveling up.</p>
      </div>
      <div class="col">
        <p class="eyebrow">Data</p>
        <p class="muted">
          Live standings, calendar, and grid lineup are courtesy of <a href="https://github.com/jolpica/jolpica-f1" rel="noreferrer noopener">jolpica-f1</a>, the community continuation of the Ergast API.
        </p>
      </div>
      <div class="col">
        <p class="eyebrow">Photos</p>
        <p class="muted">
          Driver and car portraits sourced from <a href="https://commons.wikimedia.org/" rel="noreferrer noopener">Wikimedia Commons</a> under their respective licenses. Full credits coming with v1.
        </p>
      </div>
    </div>

    <div class="footer-tail">
      <p class="mono small trust">Independent and unofficial</p>
      <p class="mono small">© {year} Into the Paddock · An independent fan project</p>
      <p class="mono small disclaimer">Not affiliated with Formula 1, FIA, FOM, or any team.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--sp-24);
    background: var(--asphalt-800);
  }

  .footer-inner {
    padding-block: var(--sp-12);
  }

  .footer-cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sp-8);
    margin-bottom: var(--sp-12);
  }

  .col p:first-child {
    margin-bottom: var(--sp-2);
  }

  .muted {
    color: var(--text-secondary);
    font-size: var(--fs-300);
  }

  .muted a {
    color: var(--kerb-yellow);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .footer-tail {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    border-top: var(--border-thin);
    padding-top: var(--sp-4);
  }

  .small {
    font-size: var(--fs-200);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--concrete);
  }

  .trust {
    color: var(--kerb-yellow);
  }

  .disclaimer {
    color: var(--text-muted);
  }

  @media (max-width: 720px) {
    .footer-cols {
      grid-template-columns: 1fr;
      gap: var(--sp-6);
    }
  }
</style>

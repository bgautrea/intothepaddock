---
import { getCollection } from 'astro:content';
import DecoderSearch from '../decoder/DecoderSearch.astro';

const { pathname } = Astro.url;

const sections = [
  { href: '/drivers', label: 'Drivers' },
  { href: '/teams', label: 'Teams' },
  { href: '/the-car', label: 'The Car' },
  { href: '/race-weekend', label: 'Race Weekend' },
  { href: '/rules', label: 'Rules' },
  { href: '/tracks', label: 'Tracks' },
  { href: '/strategy', label: 'Strategy' },
];

const isActive = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(href + '/');

// Try-one chips for the mobile decoder overlay's empty state. Same curation as
// /decoder, but the hrefs point at /decoder#slug so the overlay can be opened
// from any page.
const overlayChipSlugs = [
  'undercut',
  'parc-ferme',
  'blue-flag',
  'drs',
  'virtual-safety-car',
  'track-limits',
  'slipstream',
  'sprint',
];
const glossary = await getCollection('glossary');
const overlayChips = overlayChipSlugs
  .map((slug) => glossary.find((e) => e.id === slug))
  .filter(Boolean) as typeof glossary;
---

<nav class="nav-bar" aria-label="Primary">
  <div class="nav-inner container">
    <a href="/" class="nav-brand" aria-label="Home">
      <span class="brand-mark">▮▮▮</span>
      <span class="brand-text">INTO THE PADDOCK</span>
    </a>

    <div class="nav-links" id="primary-links">
      {
        sections.map((s) => (
          <a href={s.href} class={`nav-link ${isActive(s.href) ? 'active' : ''}`}>
            {isActive(s.href) && <span class="active-marker" aria-hidden="true">▸ </span>}
            {s.label}
          </a>
        ))
      }
    </div>

    <div class="nav-actions">
      <button
        class="nav-search-btn"
        type="button"
        aria-label="Search the decoder"
        aria-controls="nav-decoder-overlay"
        aria-expanded="false"
        id="nav-search-trigger"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="20" y1="20" x2="16.65" y2="16.65"></line>
        </svg>
        <span class="search-label">Decoder</span>
      </button>

      <button class="nav-toggle" aria-controls="primary-links" aria-expanded="false" id="nav-toggle">
        <span class="sr-only">Toggle menu</span>
        <span class="hamburger" aria-hidden="true"></span>
      </button>
    </div>
  </div>
  <span class="kerb kerb--thin" aria-hidden="true"></span>
</nav>

<div class="nav-decoder-overlay" id="nav-decoder-overlay" hidden>
  <div class="nav-decoder-overlay-head container">
    <p class="nd-eyebrow mono">The decoder</p>
    <button class="nav-decoder-close" type="button" aria-label="Close decoder search" id="nav-decoder-close">
      <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="6" y1="6" x2="18" y2="18"></line>
        <line x1="18" y1="6" x2="6" y2="18"></line>
      </svg>
    </button>
  </div>
  <div class="container nav-decoder-overlay-body">
    <DecoderSearch id="nav-decoder-search" />
    <div class="nd-chips" aria-label="Common terms">
      <p class="nd-chip-label mono">Try one</p>
      <ul class="nd-chip-list">
        {overlayChips.map((entry) => (
          <li><a class="nd-chip" href={`/decoder#${entry.id}`}>{entry.data.term}</a></li>
        ))}
      </ul>
    </div>
    <p class="nd-foot mono">
      <a href="/decoder">Browse the full decoder →</a>
    </p>
  </div>
</div>

<style>
  .nav-bar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--asphalt-900);
    border-bottom: var(--border-thin);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--nav-height);
    gap: var(--sp-4);
  }

  .nav-brand {
    display: inline-flex;
    align-items: baseline;
    gap: var(--sp-2);
    font-family: var(--font-mono);
    font-size: var(--fs-200);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text-primary);
  }

  .brand-mark {
    color: var(--kerb-yellow);
    letter-spacing: 0.05em;
  }

  .nav-links {
    display: flex;
    align-items: center;
    gap: 2px;
  }

  .nav-link {
    font-family: var(--font-display);
    font-size: var(--fs-300);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--concrete);
    padding: var(--sp-2) var(--sp-3);
    border-radius: var(--radius-sm);
    transition: color var(--dur-fast) var(--ease-snap);
    position: relative;
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-link.active {
    color: var(--kerb-yellow);
  }

  .nav-link.active::after {
    content: '';
    position: absolute;
    left: var(--sp-3);
    right: var(--sp-3);
    bottom: 2px;
    height: 2px;
    background: var(--kerb-yellow);
  }

  .active-marker {
    display: inline;
    color: var(--kerb-yellow);
  }

  .nav-actions {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .nav-search-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-2);
    background: transparent;
    border: var(--border-thin);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    cursor: pointer;
    padding: 0 var(--sp-3);
    height: 36px;
    min-width: 36px;
    transition: border-color var(--dur-fast) var(--ease-snap), color var(--dur-fast) var(--ease-snap);
  }

  .nav-search-btn:hover,
  .nav-search-btn:focus-visible {
    border-color: var(--kerb-yellow);
    color: var(--kerb-yellow);
  }

  .nav-search-btn[aria-expanded='true'] {
    border-color: var(--kerb-yellow);
    color: var(--kerb-yellow);
  }

  .search-label {
    font-family: var(--font-mono);
    font-size: var(--fs-200);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .nav-toggle {
    display: none;
    background: transparent;
    border: var(--border-thin);
    border-radius: var(--radius-sm);
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
  }

  .hamburger,
  .hamburger::before,
  .hamburger::after {
    content: '';
    display: block;
    width: 18px;
    height: 2px;
    background: var(--kerb-yellow);
    transition: transform var(--dur-fast) var(--ease-snap);
  }

  .hamburger::before {
    transform: translateY(-6px);
  }
  .hamburger::after {
    transform: translateY(4px);
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  @media (max-width: 880px) {
    .nav-toggle {
      display: inline-flex;
      width: 44px;
      height: 44px;
    }

    .search-label {
      display: none;
    }

    .nav-search-btn {
      width: 44px;
      height: 44px;
      padding: 0;
      justify-content: center;
    }

    .nav-links {
      display: none;
      position: absolute;
      top: var(--nav-height);
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      background: var(--asphalt-900);
      border-bottom: var(--border-thin);
      padding: var(--sp-4);
      gap: var(--sp-1);
    }

    .nav-bar[data-open='true'] .nav-links {
      display: flex;
    }

    .nav-link {
      padding: var(--sp-3) var(--sp-4);
    }

    .nav-link.active::after {
      left: var(--sp-4);
      bottom: 6px;
    }
  }

  /* Decoder overlay (full-screen on mobile, top-anchored sheet on desktop) */
  .nav-decoder-overlay {
    position: fixed;
    inset: 0;
    z-index: var(--decoder-search-z);
    background: var(--asphalt-900);
    overflow-y: auto;
    padding-block: var(--sp-6) var(--sp-12);
  }

  .nav-decoder-overlay[hidden] {
    display: none;
  }

  .nav-decoder-overlay-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: var(--sp-6);
  }

  .nd-eyebrow {
    color: var(--kerb-yellow);
    font-size: var(--fs-200);
    letter-spacing: 0.18em;
    text-transform: uppercase;
    margin: 0;
  }

  .nav-decoder-close {
    background: transparent;
    border: var(--border-thin);
    border-radius: var(--radius-sm);
    width: 36px;
    height: 36px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--text-primary);
    cursor: pointer;
  }

  .nav-decoder-close:hover,
  .nav-decoder-close:focus-visible {
    border-color: var(--kerb-yellow);
    color: var(--kerb-yellow);
  }

  .nav-decoder-overlay-body {
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
  }

  .nd-chips {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .nd-chip-label {
    color: var(--text-muted);
    font-size: var(--fs-200);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin: 0;
  }

  .nd-chip-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .nd-chip {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: var(--sp-2) var(--sp-4);
    background: var(--asphalt-800);
    border: var(--border-thin);
    border-radius: var(--radius-sm);
    color: var(--text-primary);
    font-size: var(--fs-300);
    text-decoration: none;
    transition: border-color var(--dur-fast) var(--ease-snap), color var(--dur-fast) var(--ease-snap);
  }

  .nd-chip:hover,
  .nd-chip:focus-visible {
    border-color: var(--kerb-yellow);
    color: var(--kerb-yellow);
  }

  .nd-foot {
    margin: 0;
    color: var(--text-muted);
    font-size: var(--fs-200);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .nd-foot a {
    color: var(--kerb-yellow);
  }
</style>

<script is:inline>
  (() => {
    const toggle = document.getElementById('nav-toggle');
    const bar = toggle?.closest('.nav-bar');
    if (toggle && bar) {
      toggle.addEventListener('click', () => {
        const isOpen = bar.getAttribute('data-open') === 'true';
        bar.setAttribute('data-open', String(!isOpen));
        toggle.setAttribute('aria-expanded', String(!isOpen));
      });
    }

    const trigger = document.getElementById('nav-search-trigger');
    const overlay = document.getElementById('nav-decoder-overlay');
    const closeBtn = document.getElementById('nav-decoder-close');

    const open = () => {
      if (!overlay || !trigger) return;
      overlay.hidden = false;
      trigger.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      const input = overlay.querySelector('input.ds-input');
      if (input instanceof HTMLInputElement) input.focus();
    };
    const close = () => {
      if (!overlay || !trigger) return;
      overlay.hidden = true;
      trigger.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      trigger.focus();
    };

    trigger?.addEventListener('click', () => {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      isOpen ? close() : open();
    });
    closeBtn?.addEventListener('click', close);
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && overlay && !overlay.hidden) close();
    });
  })();
</script>

---
interface Props {
  value: string | number;
  label: string;
  unit?: string;
  variant?: 'default' | 'large';
}

const { value, label, unit, variant = 'default' } = Astro.props;
---

<div class={`statblock statblock--${variant}`}>
  <p class="statblock-value mono">
    {value}
    {unit && <span class="statblock-unit">{unit}</span>}
  </p>
  <p class="statblock-label mono">{label}</p>
</div>

<style>
  .statblock {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    padding: var(--sp-3) 0;
  }

  .statblock-value {
    font-size: var(--fs-700);
    line-height: 1;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }

  .statblock--large .statblock-value {
    font-size: var(--fs-800);
  }

  .statblock-unit {
    font-size: var(--fs-400);
    color: var(--concrete);
    margin-left: var(--sp-1);
  }

  .statblock-label {
    font-size: var(--fs-200);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
</style>

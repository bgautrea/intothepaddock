---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  credit?: string;
  caption?: string;
  aspectRatio?: '21/9' | '16/9' | '4/3' | '3/2';
}

const { image, alt, credit, caption, aspectRatio = '21/9' } = Astro.props;
---

<figure class="photo-strip" style={`--ar: ${aspectRatio};`}>
  <div class="photo-strip-frame">
    <Image
      src={image}
      alt={alt}
      widths={[640, 960, 1280, 1600]}
      sizes="(max-width: 720px) 100vw, (max-width: 1100px) 90vw, 1100px"
      loading="lazy"
      decoding="async"
    />
  </div>
  {(credit || caption) && (
    <figcaption class="photo-credit">
      {caption && <span class="caption-text">{caption}</span>}
      {credit && <span class="credit-text mono">{credit}</span>}
    </figcaption>
  )}
</figure>

<style>
  .photo-strip {
    margin: 0;
    padding-block: var(--sp-8);
  }

  .photo-strip-frame {
    aspect-ratio: var(--ar);
    overflow: hidden;
    border: var(--border-thin);
    border-radius: var(--radius-md);
    background: var(--asphalt-800);
  }

  .photo-strip-frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .photo-credit {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--sp-2) var(--sp-4);
    margin-top: var(--sp-2);
    font-size: var(--fs-200);
    color: var(--text-muted);
  }

  .caption-text {
    color: var(--text-secondary);
  }

  .credit-text {
    letter-spacing: 0.06em;
  }
</style>

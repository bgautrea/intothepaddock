---
import type { RecapPanel } from '../../lib/raceRecaps';

interface Props {
  sectors: RecapPanel['sectorLeaders'];
}

const { sectors } = Astro.props;

function fmt(t?: number | null) {
  if (t === null || t === undefined) return 'n/a';
  return t.toFixed(3);
}
---

<div class="sector-leaders">
  <header class="sl-head">
    <h3>Sector leaders</h3>
    <p class="sl-sub mono">Best segment time, race</p>
  </header>
  <div class="sl-grid">
    {(['s1', 's2', 's3'] as const).map((key) => {
      const s = sectors[key];
      return (
        <div class="sl-cell">
          <span class="sl-label mono">Sector {key.slice(1)}</span>
          {s ? (
            <>
              <span class="sl-time mono">{fmt(s.timeSec)}<span class="sl-unit">s</span></span>
              <span class="sl-driver">{s.driverName}</span>
            </>
          ) : (
            <span class="sl-empty">No data</span>
          )}
        </div>
      );
    })}
  </div>
</div>

<style>
  .sector-leaders {
    background: var(--asphalt-800);
    border: var(--border-thin);
    border-radius: var(--radius-md);
    padding: var(--sp-5);
  }

  .sl-head {
    margin-bottom: var(--sp-4);
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--asphalt-600);
  }

  .sl-head h3 {
    font-family: var(--font-display);
    font-size: var(--fs-500);
    color: var(--text-primary);
    margin: 0 0 var(--sp-1);
  }

  .sl-sub {
    color: var(--text-muted);
    font-size: var(--fs-200);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .sl-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--sp-4);
  }

  .sl-cell {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
  }

  .sl-label {
    color: var(--kerb-yellow);
    font-size: var(--fs-200);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .sl-time {
    color: var(--text-primary);
    font-size: var(--fs-700);
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .sl-unit {
    font-size: var(--fs-300);
    color: var(--text-muted);
    margin-left: var(--sp-1);
  }

  .sl-driver {
    color: var(--text-secondary);
    font-size: var(--fs-300);
  }

  .sl-empty {
    color: var(--text-muted);
    font-size: var(--fs-300);
    font-style: italic;
  }

  @media (max-width: 560px) {
    .sl-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

---
/**
 * Per-driver stint visualization. For each of the top 5 finishers, draw a
 * horizontal bar split into stint segments scaled to lap counts. The fastest
 * lap of each stint is annotated below the bar.
 *
 * The "consistency" line gives a one-glance read on who held steady (low
 * stdev of lap times) vs. who fell off, the kind of thing a casual viewer
 * misses but explains why a driver finishing P5 might have actually had a
 * better race than a driver finishing P3.
 */
import type { RecapPanel } from '../../lib/raceRecaps';

interface Props {
  drivers: RecapPanel['stintAnalysis'];
  results: RecapPanel['results'];
  /** Show this many top finishers. Default 5. */
  limit?: number;
}

const { drivers, results, limit = 5 } = Astro.props;

// Order stintAnalysis by finishing position. Fall back to alphabetical if no result match.
const idToPos = new Map(results.map((r) => [r.driverId, r.position]));
const sorted = [...drivers]
  .filter((d) => idToPos.has(d.driverId))
  .sort((a, b) => (idToPos.get(a.driverId) ?? 99) - (idToPos.get(b.driverId) ?? 99))
  .slice(0, limit);

// Compute total lap span across all driver-stints for proportional bar widths.
const totalLaps = Math.max(
  ...sorted.flatMap((d) => d.stints.map((s) => s.endLap)),
  1
);
---

{sorted.length > 0 && (
  <div class="stint-breakdown">
    <header class="sb-head">
      <h3>How the stints played out</h3>
      <p class="sb-sub mono">Top {sorted.length}, by finishing position</p>
    </header>
    <ol class="sb-list">
      {sorted.map((d) => {
        const pos = idToPos.get(d.driverId);
        return (
          <li class="sb-row">
            <div class="sb-meta">
              <span class="sb-pos mono">P{pos}</span>
              <span class="sb-name">{d.driverName}</span>
              {typeof d.consistencySec === 'number' && (
                <span class="sb-consistency mono">±{d.consistencySec.toFixed(2)}s</span>
              )}
            </div>
            <div class="sb-bar">
              {d.stints.map((s) => {
                const widthPct = ((s.endLap - s.startLap + 1) / totalLaps) * 100;
                return (
                  <span
                    class="sb-stint"
                    style={`width: ${widthPct}%`}
                    title={`Laps ${s.startLap}–${s.endLap}, fastest ${s.fastestLapTime}`}
                  >
                    <span class="sb-stint-laps mono">L{s.startLap}–{s.endLap}</span>
                    {s.fastestLapTime && <span class="sb-stint-fastest mono">{s.fastestLapTime}</span>}
                  </span>
                );
              })}
            </div>
          </li>
        );
      })}
    </ol>
    <p class="sb-legend mono">
      <span>Stints split at pit-stop laps · width ≈ stint length</span>
      <span>Consistency = lap-time stdev (lower = steadier)</span>
    </p>
  </div>
)}

<style>
  .stint-breakdown {
    background: var(--asphalt-800);
    border: var(--border-thin);
    border-radius: var(--radius-md);
    padding: var(--sp-5);
  }

  .sb-head {
    margin-bottom: var(--sp-5);
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--asphalt-600);
  }

  .sb-head h3 {
    font-family: var(--font-display);
    font-size: var(--fs-500);
    color: var(--text-primary);
    margin: 0 0 var(--sp-1);
  }

  .sb-sub {
    color: var(--text-muted);
    font-size: var(--fs-200);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .sb-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-4);
  }

  .sb-row {
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .sb-meta {
    display: flex;
    align-items: baseline;
    gap: var(--sp-3);
  }

  .sb-pos {
    color: var(--kerb-yellow);
    font-size: var(--fs-200);
    letter-spacing: 0.12em;
    min-width: 28px;
  }

  .sb-name {
    color: var(--text-primary);
    font-size: var(--fs-400);
    flex: 1;
  }

  .sb-consistency {
    color: var(--text-muted);
    font-size: var(--fs-200);
    letter-spacing: 0.08em;
  }

  .sb-bar {
    display: flex;
    width: 100%;
    height: 44px;
    border-radius: var(--radius-sm);
    overflow: hidden;
    background: var(--asphalt-900);
    border: 1px solid var(--asphalt-700);
  }

  .sb-stint {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 2px;
    padding: var(--sp-1);
    background: var(--asphalt-700);
    border-right: 2px solid var(--asphalt-900);
    overflow: hidden;
    font-size: var(--fs-200);
    transition: background var(--dur-base) var(--ease-snap);
    cursor: help;
  }

  .sb-stint:last-child {
    border-right: 0;
  }

  .sb-stint:hover {
    background: var(--asphalt-600);
  }

  .sb-stint-laps {
    color: var(--text-secondary);
    letter-spacing: 0.08em;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }

  .sb-stint-fastest {
    color: var(--kerb-yellow);
    font-size: var(--fs-200);
    letter-spacing: 0.05em;
  }

  .sb-legend {
    display: flex;
    justify-content: space-between;
    margin: var(--sp-5) 0 0;
    color: var(--text-muted);
    font-size: var(--fs-200);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }
</style>

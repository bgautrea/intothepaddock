---
interface Props {
  raceName: string;
  circuit: string;
  raceDate: string; // ISO 8601 (UTC)
  round: number;
}

const { raceName, circuit, raceDate, round } = Astro.props;
---

<section class="countdown" aria-live="polite">
  <div class="countdown-head">
    <span class="eyebrow">Up next · Round {round}</span>
    <h2 class="countdown-title">{raceName}</h2>
    <p class="countdown-circuit">{circuit}</p>
  </div>

  <div class="countdown-grid mono" data-race-date={raceDate}>
    <div class="cd-cell"><span class="cd-num" data-unit="d">--</span><span class="cd-lbl">days</span></div>
    <div class="cd-cell"><span class="cd-num" data-unit="h">--</span><span class="cd-lbl">hrs</span></div>
    <div class="cd-cell"><span class="cd-num" data-unit="m">--</span><span class="cd-lbl">min</span></div>
    <div class="cd-cell"><span class="cd-num" data-unit="s">--</span><span class="cd-lbl">sec</span></div>
  </div>
</section>

<style>
  .countdown {
    border: var(--border-thin);
    border-radius: var(--radius-md);
    background: linear-gradient(
      135deg,
      var(--asphalt-800) 0%,
      var(--asphalt-700) 100%
    );
    padding: var(--sp-6);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--sp-6);
    align-items: center;
  }

  .countdown-title {
    font-size: var(--fs-700);
    color: var(--text-primary);
    margin-block: var(--sp-2);
  }

  .countdown-circuit {
    color: var(--concrete);
    font-size: var(--fs-400);
  }

  .countdown-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(60px, 1fr));
    gap: var(--sp-3);
  }

  .cd-cell {
    background: var(--asphalt-900);
    border: 1px solid var(--asphalt-600);
    border-radius: var(--radius-sm);
    padding: var(--sp-3) var(--sp-4);
    text-align: center;
    min-width: 64px;
  }

  .cd-num {
    display: block;
    font-size: var(--fs-700);
    color: var(--kerb-yellow);
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .cd-lbl {
    display: block;
    font-size: 0.65rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    margin-top: var(--sp-1);
  }

  @media (max-width: 720px) {
    .countdown {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const grids = document.querySelectorAll('.countdown-grid');
  grids.forEach((grid) => {
    const target = new Date(grid.getAttribute('data-race-date') || '').getTime();
    if (Number.isNaN(target)) return;

    const cells: Record<string, HTMLElement | null> = {
      d: grid.querySelector('[data-unit="d"]'),
      h: grid.querySelector('[data-unit="h"]'),
      m: grid.querySelector('[data-unit="m"]'),
      s: grid.querySelector('[data-unit="s"]'),
    };

    const tick = () => {
      const now = Date.now();
      let diff = Math.max(0, target - now);
      const days = Math.floor(diff / 86_400_000); diff -= days * 86_400_000;
      const hrs = Math.floor(diff / 3_600_000); diff -= hrs * 3_600_000;
      const mins = Math.floor(diff / 60_000); diff -= mins * 60_000;
      const secs = Math.floor(diff / 1000);
      const pad = (n: number) => String(n).padStart(2, '0');
      if (cells.d) cells.d.textContent = pad(days);
      if (cells.h) cells.h.textContent = pad(hrs);
      if (cells.m) cells.m.textContent = pad(mins);
      if (cells.s) cells.s.textContent = pad(secs);
    };

    tick();
    setInterval(tick, 1000);
  });
</script>

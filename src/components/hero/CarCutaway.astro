---
/**
 * CarCutaway — placeholder for Milestone 2.
 * Full interactive cutaway with hotspots ships in Milestone 4.
 *
 * For now: a stylized side-profile silhouette with a pit-wall caption.
 */

interface Props {
  caption?: string;
}

const { caption = 'Interactive cutaway coming soon' } = Astro.props;
---

<figure class="cutaway">
  <svg
    class="cutaway-svg"
    viewBox="0 0 800 240"
    role="img"
    aria-label="F1 car side profile placeholder"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="bodyGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#2c3037" />
        <stop offset="100%" stop-color="#16181b" />
      </linearGradient>
    </defs>

    <!-- Floor -->
    <line x1="40" y1="200" x2="760" y2="200" stroke="#2c3037" stroke-width="1" stroke-dasharray="6 4" />

    <!-- Front wing -->
    <path d="M 80 175 L 140 175 L 150 165 L 145 155 L 110 155 Z" fill="url(#bodyGrad)" stroke="#fce700" stroke-width="1.2" />
    <!-- Nose -->
    <path d="M 145 165 L 280 130 L 360 110 L 360 145 L 250 165 Z" fill="url(#bodyGrad)" stroke="#fce700" stroke-width="1.2" />
    <!-- Sidepod / chassis -->
    <path d="M 360 110 L 540 105 L 600 130 L 600 175 L 360 175 Z" fill="url(#bodyGrad)" stroke="#fce700" stroke-width="1.2" />
    <!-- Halo -->
    <path d="M 360 110 Q 410 70 470 75 Q 510 80 530 105" fill="none" stroke="#f5f5f3" stroke-width="3" />
    <!-- Engine cover / airbox -->
    <path d="M 410 80 L 470 85 L 480 105 L 410 105 Z" fill="#1f2226" stroke="#fce700" stroke-width="1" />
    <!-- Rear wing -->
    <path d="M 600 100 L 680 98 L 685 92 L 720 90 L 720 130 L 690 132 L 600 130 Z" fill="url(#bodyGrad)" stroke="#fce700" stroke-width="1.2" />
    <!-- Rear wheel -->
    <circle cx="650" cy="180" r="34" fill="#0e0f10" stroke="#3a3f47" stroke-width="2" />
    <circle cx="650" cy="180" r="18" fill="#1f2226" stroke="#fce700" stroke-width="1" />
    <!-- Front wheel -->
    <circle cx="200" cy="180" r="34" fill="#0e0f10" stroke="#3a3f47" stroke-width="2" />
    <circle cx="200" cy="180" r="18" fill="#1f2226" stroke="#fce700" stroke-width="1" />

    <!-- Caption marker dots -->
    <circle cx="115" cy="165" r="3" fill="#fce700" opacity="0.6" />
    <circle cx="320" cy="135" r="3" fill="#fce700" opacity="0.6" />
    <circle cx="450" cy="100" r="3" fill="#fce700" opacity="0.6" />
    <circle cx="700" cy="105" r="3" fill="#fce700" opacity="0.6" />
  </svg>

  <figcaption class="cutaway-caption mono">{caption}</figcaption>
</figure>

<style>
  .cutaway {
    margin: 0;
    padding: var(--sp-6);
    background: var(--asphalt-800);
    border: var(--border-thin);
    border-radius: var(--radius-md);
  }

  .cutaway-svg {
    width: 100%;
    height: auto;
    display: block;
  }

  .cutaway-caption {
    color: var(--text-muted);
    font-size: var(--fs-200);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-top: var(--sp-3);
    text-align: center;
  }
</style>

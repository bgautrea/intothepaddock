---
/**
 * CarCutaway — interactive side-view of a 2026-spec F1 car.
 *
 * Geometry follows the FIA 2026 regulation reveal: long pointed nose
 * that rises smoothly to the monocoque, halo arch over the cockpit,
 * narrow tapered sidepods sweeping into a low engine cover, compact
 * rear wing stack with a beam wing, large diffuser exit.
 *
 * 14 hotspots in two flavors:
 *   - Visible parts (front wing, nose, tyres, brakes, halo, airbox, sidepod,
 *     floor, diffuser, rear wing) draw their actual artwork.
 *   - Internal parts (monocoque, power unit, ERS, gearbox) draw a faint
 *     dashed footprint over the body region where they sit; the footprint
 *     brightens on hover, and the link scrolls to the part's deep-dive
 *     section below.
 *
 * No JS — all state is CSS, all linking is anchor-based.
 *
 * ViewBox is 1600×460. Ground y=380. Wheel radius 80, front cx=380,
 * rear cx=1280 (wheelbase 900).
 */
---

<figure class="cutaway">
  <svg
    class="cutaway-svg"
    viewBox="0 0 1600 460"
    role="img"
    aria-label="2026-spec Formula 1 car cutaway with 14 labeled parts"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="bodyGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#2a2e35" />
        <stop offset="55%" stop-color="#1a1d22" />
        <stop offset="100%" stop-color="#0e1014" />
      </linearGradient>
      <linearGradient id="haloGrad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%" stop-color="#3a3f47" />
        <stop offset="100%" stop-color="#1a1d22" />
      </linearGradient>
      <pattern id="kerbStripe" width="14" height="6" patternUnits="userSpaceOnUse">
        <rect width="7" height="6" fill="#fce700" />
        <rect x="7" width="7" height="6" fill="#f5f5f3" />
      </pattern>
    </defs>

    <!-- Asphalt strip and kerb -->
    <rect x="0" y="380" width="1600" height="22" fill="#0e0f10" />
    <line x1="0" y1="380" x2="1600" y2="380" stroke="#2c3037" stroke-width="1" />
    <rect x="0" y="402" width="1600" height="4" fill="url(#kerbStripe)" opacity="0.55" />

    <!-- ============== MAIN BODY SILHOUETTE ============== -->
    <!-- ONE continuous bezier from front-wing-tip around the top of the     -->
    <!-- car (long nose → monocoque shoulder → cockpit → engine cover →     -->
    <!-- rear) and back along the floor. No internal cross-section drawn.   -->
    <!-- Internal parts (engine, ERS, gearbox) are hotspot overlay regions. -->
    <path
      d="
        M 80,360
        L 220,356
        C 280,352 350,346 420,332
        C 480,310 540,255 620,210
        L 820,205
        C 920,222 1060,288 1220,340
        L 1230,360
        L 80,360
        Z
      "
      fill="url(#bodyGrad)"
      stroke="#2c3037"
      stroke-width="1.1"
    />

    <!-- Subtle highlight stripe along the nose top and engine cover spine -->
    <path
      d="
        M 220,352
        C 280,348 350,342 420,328
        C 480,306 540,251 620,206
        L 820,201
        C 920,218 1060,284 1220,336
        L 1220,346
        C 1060,294 920,228 820,211
        L 620,216
        C 540,261 480,316 420,338
        C 350,352 280,358 220,362
        Z
      "
      fill="#3a4049"
      opacity="0.22"
      pointer-events="none"
    />

    <!-- Cockpit opening + driver helmet — drawn AFTER body so they sit on top -->
    <!-- Cockpit opening dip: a small subtractive arc on the body top -->
    <path
      d="M 670,205 C 690,200 740,200 770,200 C 810,200 850,205 870,212 L 870,222 C 850,212 810,206 770,206 C 740,206 690,210 670,215 Z"
      fill="#0e1014"
      pointer-events="none"
    />

    <!-- ============== FRONT WING ============== -->
    <a href="#part-front-wing" aria-label="Front wing">
      <g class="part part--front-wing">
        <!-- Mainplane -->
        <path d="M 80,360 L 220,360 L 220,352 C 160,350 110,352 80,354 Z"
              fill="#15171b" stroke="#3a3f47" stroke-width="0.8" />
        <!-- Mid element -->
        <path d="M 100,348 C 150,346 190,347 220,347 L 220,341 C 190,341 150,341 100,343 Z"
              fill="#1a1d22" stroke="#3a3f47" stroke-width="0.6" />
        <!-- Top flap -->
        <path d="M 130,338 C 170,336 200,337 220,338 L 220,332 C 200,332 170,332 130,333 Z"
              fill="#1a1d22" stroke="#3a3f47" stroke-width="0.6" />
        <!-- Endplate -->
        <path d="M 220,360 L 232,358 L 236,310 L 224,308 Z"
              fill="#15171b" stroke="#3a3f47" stroke-width="0.8" />
        <rect class="hit" x="76" y="306" width="166" height="58" fill="transparent" />
        <g class="label" transform="translate(150 296)">
          <rect x="-58" y="-22" width="116" height="22" rx="3" />
          <text x="0" y="-7" text-anchor="middle">Front wing</text>
        </g>
      </g>
    </a>

    <!-- ============== NOSE ============== -->
    <!-- Outline only: the nose is part of the main body silhouette; this -->
    <!-- group highlights it on hover via the hit overlay + the T-cam bump. -->
    <a href="#part-nose" aria-label="Nose">
      <g class="part part--nose">
        <!-- T-cam bump on top of nose (the only externally visible nose feature) -->
        <rect x="500" y="280" width="14" height="5" fill="#0e0f10" stroke="#3a3f47" stroke-width="0.4" rx="1" />
        <rect class="hit" x="220" y="270" width="400" height="86" fill="transparent" />
        <g class="label" transform="translate(400 264)">
          <rect x="-32" y="-22" width="64" height="22" rx="3" />
          <text x="0" y="-7" text-anchor="middle">Nose</text>
        </g>
      </g>
    </a>

    <!-- ============== HALO ============== -->
    <a href="#part-halo" aria-label="Halo">
      <g class="part part--halo">
        <!-- Halo arch over cockpit -->
        <path d="M 660,210 C 685,150 735,128 770,128 C 810,130 845,150 870,210"
              fill="none" stroke="url(#haloGrad)" stroke-width="9" stroke-linecap="round" />
        <!-- Thin highlight on top of halo -->
        <path d="M 660,210 C 685,150 735,128 770,128 C 810,130 845,150 870,210"
              fill="none" stroke="#f5f5f3" stroke-width="1" stroke-linecap="round" opacity="0.32" />
        <!-- Front central pillar -->
        <line x1="770" y1="128" x2="770" y2="200" stroke="url(#haloGrad)" stroke-width="6" stroke-linecap="round" />
        <rect class="hit" x="650" y="116" width="230" height="98" fill="transparent" />
        <g class="label" transform="translate(770 106)">
          <rect x="-32" y="-22" width="64" height="22" rx="3" />
          <text x="0" y="-7" text-anchor="middle">Halo</text>
        </g>
      </g>
    </a>

    <!-- ============== AIRBOX ============== -->
    <a href="#part-airbox" aria-label="Airbox">
      <g class="part part--airbox">
        <!-- Periscope intake behind helmet, on the engine-cover spine -->
        <path d="M 850,184 C 846,196 846,208 852,216 L 882,218 C 890,208 890,196 884,186 Z"
              fill="#15171b" stroke="#3a3f47" stroke-width="0.9" />
        <!-- Inner intake hole -->
        <ellipse cx="867" cy="202" rx="9" ry="8" fill="#0e0f10" stroke="#2c3037" stroke-width="0.6" />
        <!-- Antenna -->
        <line x1="884" y1="186" x2="884" y2="170" stroke="#3a3f47" stroke-width="1.2" stroke-linecap="round" />
        <rect class="hit" x="844" y="164" width="56" height="58" fill="transparent" />
        <g class="label" transform="translate(870 158)">
          <rect x="-32" y="-22" width="64" height="22" rx="3" />
          <text x="0" y="-7" text-anchor="middle">Airbox</text>
        </g>
      </g>
    </a>

    <!-- ============== SIDEPOD ============== -->
    <a href="#part-sidepod" aria-label="Sidepod">
      <g class="part part--sidepod">
        <!-- Sidepod inlet behind cockpit (rectangular gaping intake) -->
        <path d="M 660,272 L 690,266 L 690,308 L 660,302 Z"
              fill="#0e0f10" stroke="#3a3f47" stroke-width="0.9" />
        <!-- Cooling slot detail along upper sidepod -->
        <path d="M 720,290 L 880,290" stroke="#3a3f47" stroke-width="0.6" />
        <rect class="hit" x="660" y="262" width="240" height="58" fill="transparent" />
        <g class="label" transform="translate(770 256)">
          <rect x="-40" y="-22" width="80" height="22" rx="3" />
          <text x="0" y="-7" text-anchor="middle">Sidepod</text>
        </g>
      </g>
    </a>

    <!-- ============== MONOCOQUE (overlay on cockpit region) ============== -->
    <a href="#part-monocoque" aria-label="Monocoque">
      <g class="part part--monocoque part--internal">
        <!-- Driver helmet (only externally visible part) -->
        <ellipse cx="745" cy="178" rx="20" ry="22" fill="#15171b" stroke="#3a3f47" stroke-width="0.9" />
        <path d="M 728,176 C 736,170 754,170 762,176 L 762,184 C 754,182 736,182 728,184 Z"
              fill="#0e0f10" stroke="#2c3037" stroke-width="0.5" />
        <!-- HANS device hint -->
        <path d="M 765,186 L 778,190 L 778,198 L 765,200 Z" fill="#1a1d22" stroke="#3a3f47" stroke-width="0.4" />
        <!-- Internal footprint (faint, brightens on hover) -->
        <path class="ghost"
              d="M 615,205 L 870,205 L 870,360 L 615,360 Z"
              fill="none" stroke="#3a3f47" stroke-width="1" stroke-dasharray="3 4" opacity="0.0" />
        <rect class="hit" x="615" y="125" width="265" height="235" fill="transparent" />
        <g class="label" transform="translate(745 372)">
          <rect x="-58" y="-2" width="116" height="22" rx="3" />
          <text x="0" y="13" text-anchor="middle">Monocoque</text>
        </g>
      </g>
    </a>

    <!-- ============== POWER UNIT (internal, overlay region) ============== -->
    <a href="#part-power-unit" aria-label="Power unit">
      <g class="part part--power-unit part--internal">
        <path class="ghost"
              d="M 870,225 L 1080,260 L 1180,300 L 870,300 Z"
              fill="none" stroke="#3a3f47" stroke-width="1" stroke-dasharray="3 4" opacity="0.0" />
        <rect class="hit" x="870" y="220" width="270" height="80" fill="transparent" />
        <g class="label" transform="translate(1010 216)">
          <rect x="-58" y="-22" width="116" height="22" rx="3" />
          <text x="0" y="-7" text-anchor="middle">Power unit</text>
        </g>
      </g>
    </a>

    <!-- ============== ERS / battery (internal, low) ============== -->
    <a href="#part-ers" aria-label="ERS">
      <g class="part part--ers part--internal">
        <path class="ghost"
              d="M 690,308 L 925,308 L 925,360 L 690,360 Z"
              fill="none" stroke="#3a3f47" stroke-width="1" stroke-dasharray="3 4" opacity="0.0" />
        <!-- Lightning bolt accent (only visible on hover) -->
        <path d="M 814,318 L 804,338 L 814,338 L 808,360"
              fill="none" stroke="#fce700" stroke-width="1.6" stroke-linecap="round" opacity="0" class="ers-bolt" />
        <rect class="hit" x="690" y="305" width="235" height="55" fill="transparent" />
        <g class="label" transform="translate(810 372)">
          <rect x="-30" y="-2" width="60" height="22" rx="3" />
          <text x="0" y="13" text-anchor="middle">ERS</text>
        </g>
      </g>
    </a>

    <!-- ============== GEARBOX (internal, between engine and rear wheel) ============== -->
    <a href="#part-gearbox" aria-label="Gearbox">
      <g class="part part--gearbox part--internal">
        <path class="ghost"
              d="M 1140,290 L 1230,330 L 1230,360 L 1140,360 Z"
              fill="none" stroke="#3a3f47" stroke-width="1" stroke-dasharray="3 4" opacity="0.0" />
        <rect class="hit" x="1140" y="280" width="100" height="80" fill="transparent" />
        <g class="label" transform="translate(1190 270)">
          <rect x="-36" y="-22" width="72" height="22" rx="3" />
          <text x="0" y="-7" text-anchor="middle">Gearbox</text>
        </g>
      </g>
    </a>

    <!-- ============== TYRES (front + rear) ============== -->
    <a href="#part-tyres" aria-label="Tyres">
      <g class="part part--tyres">
        <!-- Front tyre -->
        <circle cx="380" cy="300" r="80" fill="#0e0f10" stroke="#3a3f47" stroke-width="2" />
        <!-- Pirelli sidewall stripe (yellow = soft compound) -->
        <circle cx="380" cy="300" r="80" fill="none" stroke="#fce700" stroke-width="2" stroke-dasharray="4 9" opacity="0.55" />
        <circle cx="380" cy="300" r="48" fill="#15171b" stroke="#3a3f47" stroke-width="1" />
        <!-- Rear tyre -->
        <circle cx="1280" cy="300" r="80" fill="#0e0f10" stroke="#3a3f47" stroke-width="2" />
        <circle cx="1280" cy="300" r="80" fill="none" stroke="#fce700" stroke-width="2" stroke-dasharray="4 9" opacity="0.55" />
        <circle cx="1280" cy="300" r="48" fill="#15171b" stroke="#3a3f47" stroke-width="1" />
        <!-- Hit overlays -->
        <circle class="hit" cx="380" cy="300" r="84" fill="transparent" />
        <circle class="hit" cx="1280" cy="300" r="84" fill="transparent" />
        <g class="label" transform="translate(380 200)">
          <rect x="-32" y="-22" width="64" height="22" rx="3" />
          <text x="0" y="-7" text-anchor="middle">Tyres</text>
        </g>
      </g>
    </a>

    <!-- ============== BRAKES ============== -->
    <a href="#part-brakes" aria-label="Brakes">
      <g class="part part--brakes">
        <!-- Front brake disc -->
        <circle cx="380" cy="300" r="26" fill="#1a1d22" stroke="#fce700" stroke-width="1.2" />
        <circle cx="380" cy="300" r="26" fill="none" stroke="#3a3f47" stroke-width="0.4" stroke-dasharray="2 3" />
        <rect x="372" y="276" width="16" height="6" fill="#3a3f47" stroke="#1a1d22" stroke-width="0.4" />
        <!-- Front brake duct intake (outboard of wheel) -->
        <path d="M 290,282 L 312,288 L 312,312 L 290,318 Z" fill="#0e0f10" stroke="#3a3f47" stroke-width="0.8" />
        <!-- Rear brake disc -->
        <circle cx="1280" cy="300" r="26" fill="#1a1d22" stroke="#fce700" stroke-width="1.2" />
        <rect x="1272" y="276" width="16" height="6" fill="#3a3f47" stroke="#1a1d22" stroke-width="0.4" />
        <rect class="hit" x="284" y="276" width="36" height="50" fill="transparent" />
        <rect class="hit" x="1262" y="274" width="34" height="54" fill="transparent" />
        <g class="label" transform="translate(280 276)">
          <rect x="-50" y="-22" width="50" height="22" rx="3" />
          <text x="-25" y="-7" text-anchor="middle">Brakes</text>
        </g>
      </g>
    </a>

    <!-- ============== FLOOR ============== -->
    <a href="#part-floor" aria-label="Floor">
      <g class="part part--floor">
        <!-- Underside slice between the wheels -->
        <path d="M 290,360 L 470,362 L 700,362 L 920,362 L 1180,362 L 1230,360 L 1230,376 L 290,376 Z"
              fill="#0e0f10" stroke="#fce700" stroke-width="0.9" />
        <line x1="290" y1="376" x2="1230" y2="376" stroke="#3a3f47" stroke-width="0.6" />
        <rect class="hit" x="290" y="358" width="940" height="22" fill="transparent" />
        <g class="label" transform="translate(760 396)">
          <rect x="-32" y="-2" width="64" height="22" rx="3" />
          <text x="0" y="13" text-anchor="middle">Floor</text>
        </g>
      </g>
    </a>

    <!-- ============== DIFFUSER ============== -->
    <a href="#part-diffuser" aria-label="Diffuser">
      <g class="part part--diffuser">
        <!-- Upswept diffuser exit behind rear wheel -->
        <path d="M 1230,340 C 1290,332 1360,328 1420,330 L 1420,374 C 1360,374 1300,376 1230,378 Z"
              fill="url(#bodyGrad)" stroke="#3a3f47" stroke-width="0.9" />
        <!-- Diffuser strakes -->
        <line x1="1262" y1="338" x2="1262" y2="372" stroke="#2c3037" stroke-width="0.7" />
        <line x1="1300" y1="334" x2="1300" y2="372" stroke="#2c3037" stroke-width="0.7" />
        <line x1="1340" y1="332" x2="1340" y2="370" stroke="#2c3037" stroke-width="0.7" />
        <line x1="1380" y1="330" x2="1380" y2="368" stroke="#2c3037" stroke-width="0.7" />
        <rect class="hit" x="1228" y="324" width="200" height="56" fill="transparent" />
        <g class="label" transform="translate(1340 396)">
          <rect x="-40" y="-2" width="80" height="22" rx="3" />
          <text x="0" y="13" text-anchor="middle">Diffuser</text>
        </g>
      </g>
    </a>

    <!-- ============== REAR WING ============== -->
    <a href="#part-rear-wing" aria-label="Rear wing">
      <g class="part part--rear-wing">
        <!-- Endplate -->
        <path d="M 1380,150 L 1450,154 L 1450,310 L 1380,310 Z"
              fill="url(#bodyGrad)" stroke="#3a3f47" stroke-width="0.9" />
        <!-- Upper main plane -->
        <path d="M 1300,158 L 1450,158 L 1450,178 L 1300,178 Z"
              fill="#1a1d22" stroke="#3a3f47" stroke-width="0.9" />
        <!-- DRS slot gap (the hinge line) -->
        <line x1="1300" y1="168" x2="1450" y2="168" stroke="#0e0f10" stroke-width="2.5" />
        <!-- Lower beam wing -->
        <path d="M 1310,288 L 1450,288 L 1450,304 L 1310,304 Z"
              fill="#1a1d22" stroke="#3a3f47" stroke-width="0.9" />
        <!-- Vertical pylon between main plane and beam wing -->
        <line x1="1410" y1="178" x2="1410" y2="288" stroke="#2c3037" stroke-width="2" />
        <rect class="hit" x="1298" y="148" width="156" height="166" fill="transparent" />
        <g class="label" transform="translate(1380 138)">
          <rect x="-58" y="-22" width="116" height="22" rx="3" />
          <text x="0" y="-7" text-anchor="middle">Rear wing &amp; DRS</text>
        </g>
      </g>
    </a>

    <!-- Wheel-arch shadows (behind wheels) -->
    <ellipse cx="380" cy="402" rx="64" ry="4" fill="#000" opacity="0.55" />
    <ellipse cx="1280" cy="402" rx="64" ry="4" fill="#000" opacity="0.55" />
  </svg>

  <p class="cutaway-hint mono">
    Tap or hover any labeled part for the deep-dive ↓
  </p>
</figure>

<style>
  .cutaway {
    margin: 0;
    padding: var(--sp-6);
    background: var(--asphalt-800);
    border: var(--border-thin);
    border-radius: var(--radius-md);
    position: relative;
  }

  .cutaway-svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }

  .cutaway-hint {
    color: var(--text-muted);
    font-size: var(--fs-200);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    text-align: center;
    margin: var(--sp-4) 0 0;
  }

  .cutaway-svg a {
    cursor: pointer;
    outline: none;
  }

  .cutaway-svg .part {
    transition: filter var(--dur-base) var(--ease-snap);
  }

  .cutaway-svg .hit {
    cursor: pointer;
  }

  /* Tooltip labels: hidden by default, fade in on hover/focus. */
  .cutaway-svg .label {
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-base) var(--ease-snap);
  }
  .cutaway-svg .label rect {
    fill: var(--kerb-yellow);
    stroke: var(--asphalt-900);
    stroke-width: 0.5;
  }
  .cutaway-svg .label text {
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    fill: var(--asphalt-900);
    font-weight: 600;
  }

  /* Hover/focus → highlight stroke + glow + show label. */
  .cutaway-svg a:hover .part :is(path, rect:not(.hit), circle, line, ellipse, polyline),
  .cutaway-svg a:focus-visible .part :is(path, rect:not(.hit), circle, line, ellipse, polyline) {
    stroke: var(--kerb-yellow) !important;
  }
  .cutaway-svg a:hover .part,
  .cutaway-svg a:focus-visible .part {
    filter: drop-shadow(0 0 6px rgba(252, 231, 0, 0.45));
  }
  .cutaway-svg a:hover .label,
  .cutaway-svg a:focus-visible .label {
    opacity: 1;
  }

  /* Internal-part hotspots: brighten the dashed footprint on hover. */
  .cutaway-svg a:hover .part--internal .ghost,
  .cutaway-svg a:focus-visible .part--internal .ghost {
    opacity: 0.85;
    stroke: var(--kerb-yellow) !important;
  }

  .cutaway-svg a:hover .ers-bolt,
  .cutaway-svg a:focus-visible .ers-bolt {
    opacity: 1;
  }

  /* Halo path special-case (no fillable shape, only stroke). */
  .cutaway-svg a:hover .part--halo path,
  .cutaway-svg a:hover .part--halo line,
  .cutaway-svg a:focus-visible .part--halo path,
  .cutaway-svg a:focus-visible .part--halo line {
    stroke: var(--kerb-yellow) !important;
  }
</style>

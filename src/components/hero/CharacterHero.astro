---
/**
 * CharacterHero — driver/team page hero variant.
 *
 * Lead with a face. Photo left, name + character-read + storyline right
 * on desktop; stacked on mobile. The per-team accent stripe lives on the
 * inner edge of the photograph and uses --team-primary (which the page
 * wrapper sets via inline style on driver/team detail pages).
 *
 * Storyline copy is passed as the default slot so it can be authored as
 * Markdown / MDX in the calling page or as inline HTML.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Eyebrow label, e.g. "Driver · #44" or "Constructor · Mercedes". Optional. */
  eyebrow?: string;
  /** Headline name. Sentence case, display family applied. */
  title: string;
  /** One-line drama-forward hook in body voice. Sentence case. */
  characterRead?: string;
  photo?: ImageMetadata;
  photoAlt?: string;
  photoCredit?: string;
}

const { eyebrow, title, characterRead, photo, photoAlt, photoCredit } = Astro.props;
---

<section class="character-hero">
  <div class="container ch-grid">
    {photo && (
      <figure class="ch-photo">
        <Image
          src={photo}
          alt={photoAlt ?? title}
          widths={[480, 720, 960]}
          sizes="(max-width: 880px) 100vw, 480px"
          loading="eager"
          decoding="async"
        />
        <span class="ch-stripe" aria-hidden="true"></span>
        {photoCredit && <figcaption class="ch-credit mono">{photoCredit}</figcaption>}
      </figure>
    )}

    <div class="ch-text">
      {eyebrow && <p class="eyebrow ch-eyebrow">{eyebrow}</p>}
      <h1 class="ch-title">{title}</h1>
      {characterRead && <p class="ch-read">{characterRead}</p>}
      {Astro.slots.has('default') && (
        <div class="ch-storyline">
          <slot />
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .character-hero {
    background:
      radial-gradient(circle at 90% 10%, rgba(252, 231, 0, 0.04) 0%, transparent 45%),
      var(--asphalt-900);
    padding-block: var(--sp-12) var(--sp-16);
  }

  .ch-grid {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: var(--sp-10);
    align-items: center;
  }

  .ch-photo {
    position: relative;
    margin: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--asphalt-800);
    aspect-ratio: 4 / 5;
  }

  .ch-photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.95);
  }

  .ch-stripe {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: var(--character-hero-stripe);
    background: var(--team-primary);
    z-index: 1;
  }

  .ch-credit {
    position: absolute;
    left: var(--sp-3);
    bottom: var(--sp-3);
    font-size: var(--fs-200);
    color: var(--kerb-white);
    background: rgba(14, 15, 16, 0.7);
    padding: var(--sp-1) var(--sp-2);
    border-radius: var(--radius-sm);
    letter-spacing: 0.04em;
    max-width: calc(100% - var(--sp-6));
  }

  .ch-text {
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
  }

  .ch-eyebrow {
    color: var(--team-primary-text);
    margin: 0;
  }

  .ch-title {
    font-size: var(--fs-900);
    color: var(--text-primary);
    margin: 0;
  }

  .ch-read {
    font-size: var(--fs-500);
    line-height: 1.5;
    color: var(--text-primary);
    max-width: 56ch;
    margin: 0;
  }

  .ch-storyline {
    color: var(--text-secondary);
    font-size: var(--fs-400);
    line-height: 1.7;
    max-width: 60ch;
  }

  .ch-storyline :global(p) {
    margin: 0 0 var(--sp-3);
  }

  .ch-storyline :global(p:last-child) {
    margin-bottom: 0;
  }

  @media (max-width: 880px) {
    .character-hero {
      padding-block: var(--sp-8) var(--sp-12);
    }

    .ch-grid {
      grid-template-columns: 1fr;
      gap: var(--sp-6);
    }

    .ch-photo {
      aspect-ratio: 1 / 1;
      max-width: 480px;
    }

    .ch-stripe {
      top: auto;
      left: 0;
      right: 0;
      bottom: 0;
      width: auto;
      height: var(--character-hero-stripe);
    }
  }
</style>

---
interface Stat {
  value: string | number;
  label: string;
}

interface Props {
  href: string;
  title: string;
  subtitle?: string;
  badge?: string;
  accent?: string;
  stats?: Stat[];
}

const { href, title, subtitle, badge, accent = 'var(--kerb-yellow)', stats = [] } = Astro.props;
---

<a class="entity-card" href={href} style={`--accent: ${accent};`}>
  <span class="card-stripe" aria-hidden="true"></span>
  <div class="card-head">
    {badge && <span class="card-badge mono">{badge}</span>}
    <h3 class="card-title">{title}</h3>
    {subtitle && <p class="card-sub">{subtitle}</p>}
  </div>

  {stats.length > 0 && (
    <dl class="card-stats">
      {stats.map((s) => (
        <div class="stat">
          <dt class="stat-label">{s.label}</dt>
          <dd class="stat-value mono">{s.value}</dd>
        </div>
      ))}
    </dl>
  )}

  <span class="card-arrow mono" aria-hidden="true">▸</span>
</a>

<style>
  .entity-card {
    --accent: var(--kerb-yellow);
    background: var(--asphalt-800);
    border: var(--border-thin);
    border-radius: var(--radius-md);
    padding: var(--sp-6);
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
    overflow: hidden;
    transition:
      border-color var(--dur-base) var(--ease-snap),
      background var(--dur-base) var(--ease-snap),
      transform var(--dur-base) var(--ease-snap);
  }

  .entity-card:hover {
    border-color: var(--accent);
    background: var(--asphalt-700);
    transform: translateY(-3px);
  }

  .card-stripe {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    width: 4px;
    background: var(--accent);
    transition: width var(--dur-base) var(--ease-snap);
  }

  .entity-card:hover .card-stripe {
    width: 7px;
  }

  .card-badge {
    display: inline-block;
    color: var(--accent);
    font-size: var(--fs-200);
    letter-spacing: 0.16em;
    margin-bottom: var(--sp-2);
  }

  .card-title {
    font-size: var(--fs-700);
    color: var(--text-primary);
    line-height: 1;
    margin-bottom: var(--sp-2);
  }

  .card-sub {
    color: var(--concrete);
    font-size: var(--fs-300);
  }

  .card-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));
    gap: var(--sp-3);
    border-top: var(--border-thin);
    padding-top: var(--sp-4);
    margin: 0;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .stat-value {
    color: var(--text-primary);
    font-size: var(--fs-500);
  }

  .card-arrow {
    position: absolute;
    right: var(--sp-5);
    top: var(--sp-5);
    color: var(--accent);
    opacity: 0.6;
    font-size: var(--fs-500);
    transition: transform var(--dur-base) var(--ease-snap);
  }

  .entity-card:hover .card-arrow {
    transform: translateX(4px);
    opacity: 1;
  }
</style>

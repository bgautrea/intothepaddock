---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Stat {
  value: string | number;
  label: string;
}

interface Props {
  href: string;
  title: string;
  subtitle?: string;
  badge?: string;
  accent?: string;
  stats?: Stat[];
  image?: ImageMetadata;
  imageAlt?: string;
  /** One-line drama-forward hook, rendered above stats. Optional. */
  characterRead?: string;
}

const {
  href,
  title,
  subtitle,
  badge,
  accent = 'var(--kerb-yellow)',
  stats = [],
  image,
  imageAlt,
  characterRead,
} = Astro.props;
---

<a class="entity-card" href={href} style={`--accent: ${accent};`} data-has-image={image ? 'true' : 'false'}>
  <span class="card-stripe" aria-hidden="true"></span>

  {image && (
    <div class="card-media">
      <Image src={image} alt={imageAlt ?? title} widths={[320, 640]} sizes="(max-width: 720px) 100vw, 320px" loading="lazy" decoding="async" />
    </div>
  )}

  <div class="card-body">
    <div class="card-head">
      {badge && <span class="card-badge mono">{badge}</span>}
      <h3 class="card-title">{title}</h3>
      {subtitle && <p class="card-sub">{subtitle}</p>}
    </div>

    {characterRead && <p class="card-character-read">{characterRead}</p>}

    {stats.length > 0 && (
      <dl class="card-stats">
        {stats.map((s) => (
          <div class="stat">
            <dt class="stat-label">{s.label}</dt>
            <dd class="stat-value mono">{s.value}</dd>
          </div>
        ))}
      </dl>
    )}
  </div>

  <span class="card-arrow mono" aria-hidden="true">▸</span>
</a>

<style>
  .entity-card {
    --accent: var(--kerb-yellow);
    background: var(--asphalt-800);
    border: var(--border-thin);
    border-radius: var(--radius-md);
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition:
      border-color var(--dur-base) var(--ease-snap),
      background var(--dur-base) var(--ease-snap),
      transform var(--dur-base) var(--ease-snap);
  }

  .entity-card:hover {
    border-color: var(--accent);
    background: var(--asphalt-700);
    transform: translateY(-3px);
  }

  .card-media {
    position: relative;
    aspect-ratio: 4 / 3;
    background: var(--asphalt-900);
    overflow: hidden;
    border-bottom: 1px solid var(--asphalt-600);
  }

  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--dur-slow) var(--ease-snap);
    filter: saturate(0.95);
  }

  .entity-card:hover .card-media :global(img) {
    transform: scale(1.04);
    filter: saturate(1.05);
  }

  .card-body {
    padding: var(--sp-6);
    display: flex;
    flex-direction: column;
    gap: var(--sp-5);
    flex: 1;
  }

  .card-stripe {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 4px;
    background: var(--accent);
    z-index: 1;
    transition: height var(--dur-base) var(--ease-snap);
  }

  .entity-card:hover .card-stripe {
    height: 7px;
  }

  .card-badge {
    display: inline-block;
    color: var(--accent);
    font-size: var(--fs-200);
    letter-spacing: 0.16em;
    margin-bottom: var(--sp-2);
  }

  .card-title {
    font-size: var(--fs-700);
    color: var(--text-primary);
    line-height: 1;
    margin-bottom: var(--sp-2);
  }

  .card-sub {
    color: var(--concrete);
    font-size: var(--fs-300);
  }

  .card-character-read {
    color: var(--text-secondary);
    font-size: var(--fs-300);
    line-height: 1.5;
    margin: 0;
  }

  .card-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(80px, 1fr));
    gap: var(--sp-3);
    border-top: var(--border-thin);
    padding-top: var(--sp-4);
    margin: 0;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .stat-label {
    font-family: var(--font-mono);
    font-size: var(--fs-200);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .stat-value {
    color: var(--text-primary);
    font-size: var(--fs-500);
  }

  .card-arrow {
    position: absolute;
    right: var(--sp-5);
    top: var(--sp-5);
    color: var(--accent);
    opacity: 0.6;
    font-size: var(--fs-500);
    transition: transform var(--dur-base) var(--ease-snap);
    z-index: 2;
  }

  .entity-card[data-has-image="true"] .card-arrow {
    top: auto;
    bottom: var(--sp-5);
  }

  .entity-card:hover .card-arrow {
    transform: translateX(4px);
    opacity: 1;
  }
</style>

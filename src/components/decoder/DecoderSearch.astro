---
/**
 * DecoderSearch — live keyword search over the glossary content collection.
 *
 * Renders an accessible input plus a results list. The full glossary index
 * is serialised inline at build time (the corpus is small — under 200 terms
 * — so client-side substring matching is faster than shipping Pagefind for
 * this scale).
 *
 * Used on the homepage (inline) and on /decoder (sticky at top). A future
 * mobile-overlay variant is wired via the `variant` prop.
 *
 * Keyboard:
 *   - ↑/↓ moves selection
 *   - Enter activates the highlighted result
 *   - Esc clears the query and closes the results
 */
import { getCollection } from 'astro:content';

interface Props {
  /** Visual variant. `inline` = embedded in a page; `overlay` = full-screen mobile. */
  variant?: 'inline' | 'overlay';
  /** Optional id to disambiguate multiple instances on a page. */
  id?: string;
}

const { variant = 'inline', id = 'decoder-search' } = Astro.props;

const glossary = await getCollection('glossary');

const index = glossary
  .map((entry) => ({
    slug: entry.id,
    term: entry.data.term,
    category: entry.data.category,
    aliases: entry.data.aliases,
    youllHearWhen: entry.data.youllHearWhen,
  }))
  .sort((a, b) => a.term.localeCompare(b.term));

const inputId = `${id}-input`;
const resultsId = `${id}-results`;
const statusId = `${id}-status`;
---

<div class={`decoder-search decoder-search--${variant}`} data-decoder-search>
  <label class="ds-label" for={inputId}>
    <span class="sr-only">Search the decoder</span>
    <svg class="ds-icon" aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="11" cy="11" r="7"></circle>
      <line x1="20" y1="20" x2="16.65" y2="16.65"></line>
    </svg>
    <input
      id={inputId}
      type="search"
      class="ds-input mono"
      placeholder="Search the decoder…"
      autocomplete="off"
      spellcheck="false"
      aria-controls={resultsId}
      aria-describedby={statusId}
    />
  </label>

  <p id={statusId} class="ds-status sr-only" aria-live="polite"></p>

  <ul id={resultsId} class="ds-results" role="listbox" data-decoder-search-results>
    {index.map((entry, i) => (
      <li class="ds-result" role="option" data-haystack={`${entry.term} ${entry.aliases.join(' ')}`.toLowerCase()} aria-selected="false">
        <a class="ds-result-link" href={`/decoder#${entry.slug}`} data-result-link>
          <span class="ds-result-term">{entry.term}</span>
          <span class="ds-result-meta mono">{entry.category.replace('-', ' ')}</span>
        </a>
      </li>
    ))}
  </ul>

  <p class="ds-empty" data-decoder-search-empty hidden>
    No matches. Try a different term or <a href="/decoder">browse the full decoder</a>.
  </p>
</div>

<style>
  .decoder-search {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    width: 100%;
  }

  .ds-label {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    background: var(--decoder-search-bg);
    border: var(--border-thin);
    border-radius: var(--radius-md);
    padding: 0 var(--sp-4);
    transition: border-color var(--dur-fast) var(--ease-snap);
  }

  .ds-label:focus-within {
    border-color: var(--kerb-yellow);
  }

  .ds-icon {
    color: var(--concrete);
    flex-shrink: 0;
  }

  .ds-label:focus-within .ds-icon {
    color: var(--kerb-yellow);
  }

  .ds-input {
    flex: 1;
    min-width: 0;
    background: transparent;
    border: 0;
    color: var(--text-primary);
    font-size: var(--fs-400);
    padding: var(--sp-3) 0;
    outline: none;
  }

  .ds-input::placeholder {
    color: var(--text-muted);
  }

  .ds-results {
    list-style: none;
    margin: 0;
    padding: 0;
    display: none;
    flex-direction: column;
    gap: 1px;
    background: var(--asphalt-800);
    border: var(--border-thin);
    border-radius: var(--radius-md);
    max-height: 360px;
    overflow-y: auto;
  }

  .decoder-search[data-active='true'] .ds-results {
    display: flex;
  }

  .ds-result {
    margin: 0;
  }

  .ds-result[hidden] {
    display: none;
  }

  .ds-result-link {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-4);
    padding: var(--sp-3) var(--sp-4);
    color: var(--text-primary);
    text-decoration: none;
    transition: background var(--dur-fast) var(--ease-snap);
    min-height: 44px;
    border-bottom: 1px solid var(--asphalt-700);
  }

  .ds-result:last-child .ds-result-link {
    border-bottom: 0;
  }

  .ds-result-link:hover,
  .ds-result[aria-selected='true'] .ds-result-link {
    background: var(--asphalt-700);
  }

  .ds-result-term {
    font-size: var(--fs-400);
    color: var(--text-primary);
  }

  .ds-result-meta {
    font-size: var(--fs-200);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-muted);
    flex-shrink: 0;
  }

  .ds-empty {
    margin: 0;
    padding: var(--sp-3) var(--sp-4);
    background: var(--asphalt-800);
    border: var(--border-thin);
    border-radius: var(--radius-md);
    color: var(--text-secondary);
    font-size: var(--fs-300);
  }

  .ds-empty a {
    color: var(--kerb-yellow);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  .decoder-search--overlay {
    position: fixed;
    inset: 0;
    z-index: var(--decoder-search-z);
    background: var(--asphalt-900);
    padding: var(--sp-6);
    overflow-y: auto;
  }
</style>

<script>
  // Wire up every DecoderSearch instance on the page.
  for (const root of document.querySelectorAll<HTMLElement>('[data-decoder-search]')) {
    const input = root.querySelector<HTMLInputElement>('.ds-input');
    const resultsList = root.querySelector<HTMLUListElement>('[data-decoder-search-results]');
    const empty = root.querySelector<HTMLElement>('[data-decoder-search-empty]');

    if (!input || !resultsList || !empty) continue;

    const items = Array.from(resultsList.querySelectorAll<HTMLLIElement>('.ds-result'));
    let selectedIndex = -1;

    const setActive = (active: boolean) => {
      root.dataset.active = String(active);
    };

    const updateSelection = (index: number) => {
      const visible = items.filter((it) => !it.hidden);
      if (visible.length === 0) {
        selectedIndex = -1;
        return;
      }
      selectedIndex = ((index % visible.length) + visible.length) % visible.length;
      visible.forEach((it, i) => it.setAttribute('aria-selected', String(i === selectedIndex)));
      const el = visible[selectedIndex];
      el?.scrollIntoView({ block: 'nearest' });
    };

    const filter = (raw: string) => {
      const query = raw.trim().toLowerCase();
      if (query === '') {
        items.forEach((it) => (it.hidden = false));
        empty.hidden = true;
        setActive(false);
        selectedIndex = -1;
        items.forEach((it) => it.setAttribute('aria-selected', 'false'));
        return;
      }
      let matched = 0;
      items.forEach((it) => {
        const haystack = it.dataset.haystack ?? '';
        const hit = haystack.includes(query);
        it.hidden = !hit;
        if (hit) matched++;
      });
      empty.hidden = matched > 0;
      setActive(true);
      updateSelection(0);
    };

    input.addEventListener('input', (e) => filter((e.target as HTMLInputElement).value));

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        updateSelection(selectedIndex + 1);
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        updateSelection(selectedIndex - 1);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        const visible = items.filter((it) => !it.hidden);
        const link = visible[selectedIndex]?.querySelector<HTMLAnchorElement>('a');
        link?.click();
      } else if (e.key === 'Escape') {
        input.value = '';
        filter('');
        input.blur();
      }
    });

    input.addEventListener('focus', () => {
      if (input.value.trim() !== '') setActive(true);
    });
  }
</script>

---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CharacterHero from '../../components/hero/CharacterHero.astro';
import KerbDivider from '../../components/ui/KerbDivider.astro';
import StatBlock from '../../components/ui/StatBlock.astro';
import EntityCard from '../../components/cards/EntityCard.astro';
import { getDriverStandings, getConstructorStandings } from '../../lib/jolpica';
import { constructorIdToSlug, getTeamTextColor } from '../../lib/teamColors';

export async function getStaticPaths() {
  const teams = await getCollection('teams');
  return teams.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const t = entry.data;
const teamTextColor = getTeamTextColor(entry.id);

const stripDiacritics = (s: string): string =>
  s.normalize('NFD').replace(/[̀-ͯ]/g, '');

const standings = await getDriverStandings();
const driverPos = new Map<string, number>();
for (const s of standings) {
  const pos = parseInt(s.position, 10);
  const fam = stripDiacritics(s.Driver.familyName.toLowerCase());
  const giv = stripDiacritics(s.Driver.givenName.toLowerCase()).replace(/\s+/g, '-');
  const candidates = [
    s.Driver.driverId.replace(/_/g, '-'),
    fam,
    `${giv}-${fam}`,
    `${giv.split('-')[0]}-${fam}`,
  ];
  for (const c of candidates) driverPos.set(c, pos);
}

const allDrivers = await getCollection('drivers');
const lineup = allDrivers
  .filter((d) => d.data.status === 'active')
  .filter((d) => {
    const ref = d.data.team;
    if (!ref) return false;
    return typeof ref === 'string' ? ref === entry.id : ref.id === entry.id;
  })
  .map((d) => {
    const fam = stripDiacritics(d.data.name.toLowerCase()).split(' ').slice(-1)[0];
    const pos = driverPos.get(d.id) ?? driverPos.get(fam);
    return {
      slug: d.id,
      pos,
      href: `/drivers/${d.id}`,
      title: d.data.name,
      badge: pos ? `P${pos}` : `#${d.data.number}`,
      subtitle: t.shortName,
      accent: t.primaryColor,
      image: d.data.portrait,
      imageAlt: `Portrait of ${d.data.name}`,
      characterRead: d.data.characterRead,
      stats: [
        { label: 'Wins', value: d.data.careerWins },
        { label: 'Podiums', value: d.data.careerPodiums },
        { label: 'Titles', value: d.data.championships },
      ],
    };
  })
  .sort((a, b) => (a.pos ?? 99) - (b.pos ?? 99));

const constructors = await getConstructorStandings();
const ctorRow = constructors.find((c) => constructorIdToSlug(c.Constructor.constructorId) === entry.id);
const ctorPos = ctorRow ? parseInt(ctorRow.position, 10) : undefined;
const ctorPts = ctorRow?.points;

const allRecaps = await getCollection('raceRecaps');
const latestRecap = allRecaps
  .filter((r) => r.data.draftStatus !== 'draft')
  .sort((a, b) => {
    if (a.data.season !== b.data.season) return b.data.season - a.data.season;
    return b.data.round - a.data.round;
  })[0] ?? null;
---

<BaseLayout title={t.name} description={t.tagline}>
  <article style={`--team-primary: ${t.primaryColor}; --team-primary-text: ${teamTextColor};`}>
    <CharacterHero
      eyebrow={t.principalCharacterRead ? `Team principal · ${t.teamPrincipal}` : 'Constructor'}
      title={t.shortName}
      characterRead={t.principalCharacterRead}
      photo={t.car}
      photoAlt={`${t.shortName} F1 car`}
      photoCredit={t.carCredit}
    >
      <p>{t.tagline}</p>
    </CharacterHero>

    <KerbDivider variant="thin" />

    <section class="container meta-strip">
      <dl class="meta">
        <div><dt>Full name</dt><dd>{t.name}</dd></div>
        <div><dt>Base</dt><dd>{t.base}</dd></div>
        <div><dt>Team principal</dt><dd>{t.teamPrincipal}</dd></div>
        <div><dt>Power unit</dt><dd>{t.powerUnit}</dd></div>
      </dl>
    </section>

    <KerbDivider variant="thin" />

    <section class="container long-form">
      <Content />
    </section>

    <KerbDivider variant="thin" />

    <section class="container constructor-receipts">
      <header class="cr-head">
        <h2>Constructor receipts</h2>
        <p class="cr-sub mono">Through the {new Date().getFullYear()} season</p>
      </header>
      <div class="constructor-stats-grid">
        <StatBlock value={t.constructorTitles} label="Constructor titles" />
        <StatBlock value={t.foundedSeason} label="First season" />
        {ctorPos !== undefined && <StatBlock value={`P${ctorPos}`} label={`${new Date().getFullYear()} standing`} />}
        {ctorPts && <StatBlock value={ctorPts} label="Points" />}
      </div>
    </section>

    {latestRecap && (
      <>
        <KerbDivider variant="thin" />
        <section class="container last-race-section">
          <header class="lrs-head">
            <h2>Last race</h2>
            <p class="lrs-sub mono">Decoder breakdown of the most recent round</p>
          </header>
          <a class="last-race-card" href={`/race-recaps/${latestRecap.id}`}>
            <span class="lrc-round mono">R{String(latestRecap.data.round).padStart(2, '0')}</span>
            <span class="lrc-name">{latestRecap.data.raceName}</span>
            <span class="lrc-date mono">
              {latestRecap.data.raceDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}
            </span>
            <span class="lrc-cta mono">Read the decoder →</span>
          </a>
        </section>
      </>
    )}

    {lineup.length > 0 && (
      <>
        <KerbDivider variant="thin" />
        <section class="container lineup-section">
          <header class="lineup-head">
            <h2>Current lineup</h2>
            <p class="lineup-sub mono">2026 driver pairing</p>
          </header>
          <div class="lineup-grid">
            {lineup.map((d) => <EntityCard {...d} />)}
          </div>
        </section>
      </>
    )}
  </article>
</BaseLayout>

<style>
  .constructor-receipts {
    padding-block: var(--sp-12);
  }

  .cr-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-bottom: var(--sp-6);
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--asphalt-600);
  }

  .cr-head h2 {
    font-family: var(--font-display);
    font-size: var(--fs-700);
    color: var(--text-primary);
    margin: 0;
  }

  .cr-sub {
    color: var(--text-muted);
    font-size: var(--fs-200);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .constructor-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--sp-6);
  }

  .meta-strip {
    padding-block: var(--sp-6);
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--sp-5) var(--sp-8);
    margin: 0;
  }

  .meta div {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    border-top: 1px solid var(--asphalt-600);
    padding-top: var(--sp-2);
  }

  .meta dt {
    font-family: var(--font-mono);
    font-size: var(--fs-200);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .meta dd {
    margin: 0;
    color: var(--text-primary);
  }

  .long-form {
    padding-block: var(--sp-12);
    max-width: 720px;
  }

  .long-form :global(p) {
    color: var(--text-secondary);
    font-size: var(--fs-500);
    line-height: 1.7;
    margin-bottom: var(--sp-4);
  }

  .long-form :global(h2) {
    font-size: var(--fs-600);
    margin-block: var(--sp-8) var(--sp-3);
    color: var(--text-primary);
  }

  .lineup-section,
  .last-race-section {
    padding-block: var(--sp-12);
  }

  .lrs-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--sp-6);
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--asphalt-600);
  }

  .lrs-head h2 {
    font-family: var(--font-display);
    font-size: var(--fs-700);
    color: var(--text-primary);
    margin: 0;
  }

  .lrs-sub {
    color: var(--text-muted);
    font-size: var(--fs-200);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .last-race-card {
    display: grid;
    grid-template-columns: 60px 1fr auto auto;
    align-items: baseline;
    gap: var(--sp-4);
    padding: var(--sp-4) var(--sp-5);
    background: var(--asphalt-800);
    border: var(--border-thin);
    border-left: 3px solid var(--team-primary);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: background var(--dur-base) var(--ease-snap), transform var(--dur-base) var(--ease-snap);
  }

  .last-race-card:hover {
    background: var(--asphalt-700);
    transform: translateX(2px);
  }

  .lrc-round {
    color: var(--team-primary-text);
    font-size: var(--fs-200);
    letter-spacing: 0.12em;
  }

  .lrc-name {
    color: var(--text-primary);
    font-size: var(--fs-500);
  }

  .lrc-date {
    color: var(--text-muted);
    font-size: var(--fs-200);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .lrc-cta {
    color: var(--team-primary-text);
    font-size: var(--fs-200);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  @media (max-width: 600px) {
    .last-race-card {
      grid-template-columns: 50px 1fr;
    }

    .lrc-date,
    .lrc-cta {
      grid-column: 2;
      text-align: left;
    }
  }

  .lineup-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--sp-6);
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--team-primary);
  }

  .lineup-head h2 {
    font-family: var(--font-display);
    font-size: var(--fs-700);
    color: var(--text-primary);
    margin: 0;
  }

  .lineup-sub {
    color: var(--text-muted);
    font-size: var(--fs-200);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .lineup-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--sp-5);
  }
</style>

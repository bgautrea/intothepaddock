---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/hero/Hero.astro';
import KerbDivider from '../../components/ui/KerbDivider.astro';
import StatBlock from '../../components/ui/StatBlock.astro';
import EntityCard from '../../components/cards/EntityCard.astro';
import { getDriverStandings, getConstructorStandings } from '../../lib/jolpica';
import { constructorIdToSlug } from '../../lib/teamColors';

export async function getStaticPaths() {
  const teams = await getCollection('teams');
  return teams.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const t = entry.data;

const stripDiacritics = (s: string): string =>
  s.normalize('NFD').replace(/[̀-ͯ]/g, '');

const standings = await getDriverStandings();
const driverPos = new Map<string, number>();
for (const s of standings) {
  const pos = parseInt(s.position, 10);
  const fam = stripDiacritics(s.Driver.familyName.toLowerCase());
  const giv = stripDiacritics(s.Driver.givenName.toLowerCase()).replace(/\s+/g, '-');
  const candidates = [
    s.Driver.driverId.replace(/_/g, '-'),
    fam,
    `${giv}-${fam}`,
    `${giv.split('-')[0]}-${fam}`,
  ];
  for (const c of candidates) driverPos.set(c, pos);
}

const allDrivers = await getCollection('drivers');
const lineup = allDrivers
  .filter((d) => d.data.status === 'active')
  .filter((d) => {
    const ref = d.data.team;
    if (!ref) return false;
    return typeof ref === 'string' ? ref === entry.id : ref.id === entry.id;
  })
  .map((d) => {
    const fam = stripDiacritics(d.data.name.toLowerCase()).split(' ').slice(-1)[0];
    const pos = driverPos.get(d.id) ?? driverPos.get(fam);
    return {
      slug: d.id,
      pos,
      href: `/drivers/${d.id}`,
      title: d.data.name,
      badge: pos ? `P${pos}` : `#${d.data.number}`,
      subtitle: t.shortName,
      accent: t.primaryColor,
      stats: [
        { label: 'Wins', value: d.data.careerWins },
        { label: 'Podiums', value: d.data.careerPodiums },
        { label: 'Titles', value: d.data.championships },
      ],
    };
  })
  .sort((a, b) => (a.pos ?? 99) - (b.pos ?? 99));

const constructors = await getConstructorStandings();
const ctorRow = constructors.find((c) => constructorIdToSlug(c.Constructor.constructorId) === entry.id);
const ctorPos = ctorRow ? parseInt(ctorRow.position, 10) : undefined;
const ctorPts = ctorRow?.points;
---

<BaseLayout title={t.name} description={t.tagline}>
  <article style={`--team-primary: ${t.primaryColor};`}>
    <Hero eyebrow="Constructor" title={t.shortName} subtitle={t.tagline}>
      <Fragment slot="visual">
        <div class="team-stats-grid">
          <StatBlock value={t.constructorTitles} label="Constructor titles" />
          <StatBlock value={t.foundedSeason} label="First season" />
          {ctorPos !== undefined && <StatBlock value={`P${ctorPos}`} label="2026 standing" />}
          {ctorPts && <StatBlock value={ctorPts} label="Points" />}
        </div>
      </Fragment>
    </Hero>

    <KerbDivider variant="thin" />

    <section class="container meta-strip">
      <dl class="meta">
        <div><dt>Full name</dt><dd>{t.name}</dd></div>
        <div><dt>Base</dt><dd>{t.base}</dd></div>
        <div><dt>Team principal</dt><dd>{t.teamPrincipal}</dd></div>
        <div><dt>Power unit</dt><dd>{t.powerUnit}</dd></div>
      </dl>
    </section>

    <KerbDivider variant="thin" />

    <section class="container long-form">
      <Content />
    </section>

    {lineup.length > 0 && (
      <>
        <KerbDivider variant="thin" />
        <section class="container lineup-section">
          <header class="lineup-head">
            <h2>Current lineup</h2>
            <p class="lineup-sub mono">2026 driver pairing</p>
          </header>
          <div class="lineup-grid">
            {lineup.map((d) => <EntityCard {...d} />)}
          </div>
        </section>
      </>
    )}
  </article>
</BaseLayout>

<style>
  .team-stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-3);
    width: 100%;
  }

  .meta-strip {
    padding-block: var(--sp-6);
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--sp-5) var(--sp-8);
    margin: 0;
  }

  .meta div {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    border-left: 2px solid var(--asphalt-600);
    padding-left: var(--sp-4);
  }

  .meta dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .meta dd {
    margin: 0;
    color: var(--text-primary);
  }

  .long-form {
    padding-block: var(--sp-12);
    max-width: 720px;
  }

  .long-form :global(p) {
    color: var(--text-secondary);
    font-size: var(--fs-500);
    line-height: 1.7;
    margin-bottom: var(--sp-4);
  }

  .long-form :global(h2) {
    font-size: var(--fs-600);
    margin-block: var(--sp-8) var(--sp-3);
    border-left: 4px solid var(--team-primary);
    padding-left: var(--sp-3);
  }

  .lineup-section {
    padding-block: var(--sp-12);
  }

  .lineup-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--sp-6);
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--team-primary);
  }

  .lineup-head h2 {
    font-family: var(--font-display);
    font-size: var(--fs-700);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-primary);
    margin: 0;
  }

  .lineup-sub {
    color: var(--text-muted);
    font-size: var(--fs-200);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .lineup-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--sp-5);
  }
</style>

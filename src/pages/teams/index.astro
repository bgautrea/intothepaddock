---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/hero/Hero.astro';
import EntityCard from '../../components/cards/EntityCard.astro';
import KerbDivider from '../../components/ui/KerbDivider.astro';
import { getConstructorStandings } from '../../lib/jolpica';
import { constructorIdToSlug } from '../../lib/teamColors';

const teams = await getCollection('teams');

// Build a position lookup keyed by our team slug.
const standings = await getConstructorStandings();
const positionBySlug = new Map<string, number>();
const pointsBySlug = new Map<string, string>();
for (const s of standings) {
  const slug = constructorIdToSlug(s.Constructor.constructorId);
  if (!slug) continue;
  positionBySlug.set(slug, parseInt(s.position, 10));
  pointsBySlug.set(slug, s.points);
}

const cards = teams
  .map((t) => ({
    slug: t.id,
    pos: positionBySlug.get(t.id),
    pts: pointsBySlug.get(t.id),
    href: `/teams/${t.id}`,
    title: t.data.shortName,
    badge: positionBySlug.get(t.id) ? `P${positionBySlug.get(t.id)}` : `EST ${t.data.foundedSeason}`,
    subtitle: t.data.tagline,
    accent: t.data.primaryColor,
    image: t.data.car,
    imageAlt: `${t.data.shortName} F1 car`,
    stats: [
      { label: 'Titles', value: t.data.constructorTitles },
      { label: 'Pts', value: pointsBySlug.get(t.id) ?? '—' },
      { label: 'Power unit', value: t.data.powerUnit },
    ],
  }))
  .sort((a, b) => (a.pos ?? 99) - (b.pos ?? 99));
---

<BaseLayout title="Teams" description="The eleven F1 constructors. Every team's story, base, and engineering philosophy.">
  <Hero
    eyebrow="Section 02"
    title="The Teams"
    subtitle="Eleven constructors fighting for the championship. Each one designs and builds its own car under the regulations, and that engineering identity is what makes a team."
  />

  <KerbDivider variant="thin" />

  <section class="container teams-section">
    <header class="section-head">
      <h2 class="section-title">2026 constructors</h2>
      <p class="section-sub mono">Sorted by current championship position</p>
    </header>
    <div class="grid">
      {cards.map((c) => <EntityCard {...c} />)}
    </div>
  </section>
</BaseLayout>

<style>
  .teams-section {
    padding-block: var(--sp-12);
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-bottom: var(--sp-6);
    padding-bottom: var(--sp-3);
    border-bottom: var(--border-thin);
  }

  .section-title {
    font-family: var(--font-display);
    font-size: var(--fs-700);
    color: var(--text-primary);
    margin: 0;
  }

  .section-sub {
    color: var(--text-muted);
    font-size: var(--fs-200);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: var(--sp-5);
  }
</style>

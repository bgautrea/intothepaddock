---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CharacterHero from '../../components/hero/CharacterHero.astro';
import KerbDivider from '../../components/ui/KerbDivider.astro';
import StatBlock from '../../components/ui/StatBlock.astro';
import NextRaceCountdown from '../../components/live/NextRaceCountdown.astro';
import { getNextRace, raceStartISO } from '../../lib/jolpica';
import { getTeamTextColor } from '../../lib/teamColors';

export async function getStaticPaths() {
  const drivers = await getCollection('drivers');
  return drivers.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const team = entry.data.team ? await getEntry(entry.data.team) : null;
const { Content } = await render(entry);

const teamLabel = team?.data.shortName ?? entry.data.legendaryTeam ?? 'Driver';
const teamColor = team?.data.primaryColor ?? 'var(--kerb-yellow)';
const teamTextColor = team ? getTeamTextColor(team.id) : 'var(--kerb-yellow)';
const dobYear = entry.data.dob.getFullYear();
const age = new Date().getFullYear() - dobYear;

let teammate: { name: string; href: string; number: number } | null = null;
if (team) {
  const allDrivers = await getCollection('drivers');
  const found = allDrivers.find((d) => {
    if (d.id === entry.id) return false;
    if (d.data.status !== 'active') return false;
    const ref = d.data.team;
    if (!ref) return false;
    return typeof ref === 'string' ? ref === team.id : ref.id === team.id;
  });
  if (found) {
    teammate = {
      name: found.data.name,
      href: `/drivers/${found.id}`,
      number: found.data.number,
    };
  }
}

const next = entry.data.status === 'active' ? await getNextRace() : null;

// Most recent published recap (any track). Hidden if none exist yet.
const allRecaps = await getCollection('raceRecaps');
const latestRecap = allRecaps
  .filter((r) => r.data.draftStatus !== 'draft')
  .sort((a, b) => {
    if (a.data.season !== b.data.season) return b.data.season - a.data.season;
    return b.data.round - a.data.round;
  })[0] ?? null;
---

<BaseLayout title={entry.data.name} description={entry.data.bio}>
  <article style={`--team-primary: ${teamColor}; --team-primary-text: ${teamTextColor};`}>
    <CharacterHero
      eyebrow={`#${entry.data.number} · ${teamLabel}`}
      title={entry.data.name}
      characterRead={entry.data.characterRead}
      photo={entry.data.portrait}
      photoAlt={`Portrait of ${entry.data.name}`}
      photoCredit={entry.data.portraitCredit}
    >
      <p>{entry.data.bio}</p>
    </CharacterHero>

    <KerbDivider variant="thin" />

    <section class="container meta-strip">
      <dl class="meta">
        <div><dt>Nationality</dt><dd>{entry.data.nationality}</dd></div>
        <div><dt>Born</dt><dd>{entry.data.dob.toISOString().slice(0, 10)} · {entry.data.birthplace} · age {age}</dd></div>
        <div><dt>Debut</dt><dd>{entry.data.debutSeason}</dd></div>
        <div><dt>Status</dt><dd class="status">{entry.data.status}</dd></div>
        {teammate && (
          <div>
            <dt>Teammate</dt>
            <dd><a class="teammate-link" href={teammate.href}>{teammate.name} <span class="mono">#{teammate.number}</span></a></dd>
          </div>
        )}
      </dl>
    </section>

    <KerbDivider variant="thin" />

    <section class="container long-form">
      <Content />

      {entry.data.funFact && (
        <aside class="fun-fact">
          <span class="eyebrow">Fun fact</span>
          <p>{entry.data.funFact}</p>
        </aside>
      )}
    </section>

    <KerbDivider variant="thin" />

    <section class="container career-receipts">
      <header class="cr-head">
        <h2>Career receipts</h2>
        <p class="cr-sub mono">Through the {new Date().getFullYear()} season</p>
      </header>
      <div class="career-stats-grid">
        <StatBlock value={entry.data.careerWins} label="Race wins" />
        <StatBlock value={entry.data.careerPodiums} label="Podiums" />
        <StatBlock value={entry.data.careerPoles} label="Pole positions" />
        <StatBlock value={entry.data.championships} label="Championships" />
      </div>
    </section>

    {latestRecap && (
      <>
        <KerbDivider variant="thin" />
        <section class="container last-race-section">
          <header class="lrs-head">
            <h2>Last race</h2>
            <p class="lrs-sub mono">Decoder breakdown of the most recent round</p>
          </header>
          <a class="last-race-card" href={`/race-recaps/${latestRecap.id}`}>
            <span class="lrc-round mono">R{String(latestRecap.data.round).padStart(2, '0')}</span>
            <span class="lrc-name">{latestRecap.data.raceName}</span>
            <span class="lrc-date mono">
              {latestRecap.data.raceDate.toLocaleDateString('en-GB', { day: '2-digit', month: 'short', year: 'numeric' })}
            </span>
            <span class="lrc-cta mono">Read the decoder →</span>
          </a>
        </section>
      </>
    )}

    {next && (
      <>
        <KerbDivider variant="thin" />
        <section class="container next-race-section">
          <header class="nrs-head">
            <h2>Next on track</h2>
            <p class="nrs-sub mono">Where you'll see {entry.data.name.split(' ').slice(-1)[0]} next</p>
          </header>
          <NextRaceCountdown
            raceName={next.raceName}
            circuit={`${next.Circuit.circuitName} · ${next.Circuit.Location.locality}`}
            raceDate={raceStartISO(next)}
            round={Number(next.round)}
          />
        </section>
      </>
    )}
  </article>
</BaseLayout>

<style>
  .career-receipts {
    padding-block: var(--sp-12);
  }

  .cr-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-4);
    margin-bottom: var(--sp-6);
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--asphalt-600);
  }

  .cr-head h2 {
    font-family: var(--font-display);
    font-size: var(--fs-700);
    color: var(--text-primary);
    margin: 0;
  }

  .cr-sub {
    color: var(--text-muted);
    font-size: var(--fs-200);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .career-stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--sp-6);
  }

  .meta-strip {
    padding-block: var(--sp-6);
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--sp-5) var(--sp-8);
    margin: 0;
  }

  .meta div {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    border-top: 1px solid var(--asphalt-600);
    padding-top: var(--sp-2);
  }

  .meta dt {
    font-family: var(--font-mono);
    font-size: var(--fs-200);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .meta dd {
    margin: 0;
    color: var(--text-primary);
    font-size: var(--fs-400);
  }

  .meta .status {
    text-transform: uppercase;
    color: var(--team-primary-text);
    font-family: var(--font-mono);
    letter-spacing: 0.12em;
    font-size: var(--fs-300);
  }

  .teammate-link {
    color: var(--text-primary);
    text-decoration: none;
    border-bottom: 1px dashed var(--team-primary);
    transition: color var(--dur-base) var(--ease-snap);
  }

  .teammate-link:hover {
    color: var(--team-primary-text);
  }

  .long-form {
    padding-block: var(--sp-12);
    max-width: 720px;
  }

  .long-form :global(h2) {
    font-size: var(--fs-600);
    margin-block: var(--sp-8) var(--sp-3);
    color: var(--text-primary);
  }

  .long-form :global(h2:first-child) {
    margin-top: 0;
  }

  .long-form :global(p) {
    color: var(--text-secondary);
    font-size: var(--fs-500);
    line-height: 1.7;
    margin-bottom: var(--sp-4);
  }

  .long-form :global(ul) {
    color: var(--text-secondary);
    font-size: var(--fs-400);
    line-height: 1.7;
    padding-left: var(--sp-6);
  }

  .long-form :global(li) {
    margin-bottom: var(--sp-2);
  }

  .fun-fact {
    margin-top: var(--sp-8);
    padding: var(--sp-5);
    background: var(--asphalt-800);
    border: var(--border-thin);
    border-top: 3px solid var(--team-primary);
    border-radius: var(--radius-sm);
  }

  .fun-fact .eyebrow {
    color: var(--team-primary-text);
    margin-bottom: var(--sp-2);
  }

  .fun-fact p {
    margin: 0;
    color: var(--text-primary);
    font-style: italic;
  }

  .next-race-section,
  .last-race-section {
    padding-block: var(--sp-12);
  }

  .lrs-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--sp-6);
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--asphalt-600);
  }

  .lrs-head h2 {
    font-family: var(--font-display);
    font-size: var(--fs-700);
    color: var(--text-primary);
    margin: 0;
  }

  .lrs-sub {
    color: var(--text-muted);
    font-size: var(--fs-200);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .last-race-card {
    display: grid;
    grid-template-columns: 60px 1fr auto auto;
    align-items: baseline;
    gap: var(--sp-4);
    padding: var(--sp-4) var(--sp-5);
    background: var(--asphalt-800);
    border: var(--border-thin);
    border-left: 3px solid var(--team-primary);
    border-radius: var(--radius-md);
    text-decoration: none;
    color: inherit;
    transition: background var(--dur-base) var(--ease-snap), transform var(--dur-base) var(--ease-snap);
  }

  .last-race-card:hover {
    background: var(--asphalt-700);
    transform: translateX(2px);
  }

  .lrc-round {
    color: var(--team-primary-text);
    font-size: var(--fs-200);
    letter-spacing: 0.12em;
  }

  .lrc-name {
    color: var(--text-primary);
    font-size: var(--fs-500);
  }

  .lrc-date {
    color: var(--text-muted);
    font-size: var(--fs-200);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .lrc-cta {
    color: var(--team-primary-text);
    font-size: var(--fs-200);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  @media (max-width: 600px) {
    .last-race-card {
      grid-template-columns: 50px 1fr;
    }

    .lrc-date,
    .lrc-cta {
      grid-column: 2;
      text-align: left;
    }
  }

  .nrs-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: var(--sp-6);
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--team-primary);
  }

  .nrs-head h2 {
    font-family: var(--font-display);
    font-size: var(--fs-700);
    color: var(--text-primary);
    margin: 0;
  }

  .nrs-sub {
    color: var(--text-muted);
    font-size: var(--fs-200);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
</style>

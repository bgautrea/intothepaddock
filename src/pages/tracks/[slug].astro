---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/hero/Hero.astro';
import KerbDivider from '../../components/ui/KerbDivider.astro';
import StatBlock from '../../components/ui/StatBlock.astro';
import PhotoStrip from '../../components/ui/PhotoStrip.astro';
import CircuitMap from '../../components/hero/CircuitMap.astro';

export async function getStaticPaths() {
  const tracks = await getCollection('tracks');
  return tracks.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const t = entry.data;
---

<BaseLayout title={t.grandPrix} description={`${t.name} — ${t.city}, ${t.country}`}>
  <article>
    <Hero
      eyebrow={t.nickname ? `${t.country} · ${t.nickname}` : t.country}
      title={t.grandPrix}
      subtitle={t.name}
    >
      <Fragment slot="visual">
        <div class="track-stats-grid">
          <StatBlock value={t.lengthKm} unit="km" label="Lap length" />
          <StatBlock value={t.laps} label="Laps" />
          <StatBlock value={t.corners} label="Corners" />
          <StatBlock value={t.drsZones} label="DRS zones" />
        </div>
      </Fragment>
    </Hero>

    {t.photo && (
      <section class="container">
        <PhotoStrip
          image={t.photo}
          alt={`${t.name}, ${t.city}`}
          aspectRatio="16/9"
          credit={t.photoCredit}
        />
      </section>
    )}

    <KerbDivider variant="thin" />

    <section class="container meta-strip">
      <dl class="meta">
        <div><dt>City</dt><dd>{t.city}</dd></div>
        <div><dt>First GP</dt><dd>{t.firstGp}</dd></div>
        <div><dt>Race distance</dt><dd>{t.raceDistanceKm} km</dd></div>
        {t.lapRecord && (
          <div>
            <dt>Lap record</dt>
            <dd>{t.lapRecord.time} · {t.lapRecord.driver} ({t.lapRecord.year})</dd>
          </div>
        )}
      </dl>
    </section>

    <KerbDivider variant="thin" />

    <section class="container map-and-stats">
      <div class="map-col">
        <CircuitMap
          grandPrix={t.grandPrix}
          country={t.country}
          round={t.calendarRound}
          geojsonFile={t.geojsonFile}
        />
      </div>
      <aside class="stats-col">
        <h2 class="stats-h">By the numbers</h2>
        <dl class="stats-list">
          <div><dt>Lap length</dt><dd class="mono">{t.lengthKm} km</dd></div>
          <div><dt>Race distance</dt><dd class="mono">{t.raceDistanceKm} km</dd></div>
          <div><dt>Laps</dt><dd class="mono">{t.laps}</dd></div>
          <div><dt>Corners</dt><dd class="mono">{t.corners}</dd></div>
          <div><dt>DRS zones</dt><dd class="mono">{t.drsZones}</dd></div>
          {t.difficulty && <div><dt>Difficulty</dt><dd class="badge">{t.difficulty}</dd></div>}
          {t.overtakingDifficulty && <div><dt>Overtaking</dt><dd class="badge">{t.overtakingDifficulty}</dd></div>}
        </dl>
        {t.lapRecord && (
          <div class="lap-record">
            <span class="lr-eyebrow mono">Lap record</span>
            <span class="lr-time mono">{t.lapRecord.time}</span>
            <span class="lr-driver">{t.lapRecord.driver}</span>
            <span class="lr-year mono">{t.lapRecord.year}</span>
          </div>
        )}
      </aside>
    </section>

    <KerbDivider variant="thin" />

    <section class="container long-form">
      <Content />
    </section>
  </article>
</BaseLayout>

<style>
  .track-stats-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sp-3);
    width: 100%;
  }

  .meta-strip {
    padding-block: var(--sp-6);
  }

  .meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--sp-5) var(--sp-8);
    margin: 0;
  }

  .meta div {
    display: flex;
    flex-direction: column;
    gap: var(--sp-1);
    border-left: 2px solid var(--asphalt-600);
    padding-left: var(--sp-4);
  }

  .meta dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .meta dd {
    margin: 0;
    color: var(--text-primary);
  }

  .map-and-stats {
    padding-block: var(--sp-12);
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: var(--sp-8);
    align-items: start;
  }

  .stats-col {
    background: var(--asphalt-800);
    border: var(--border-thin);
    border-radius: var(--radius-md);
    padding: var(--sp-6);
  }

  .stats-h {
    font-family: var(--font-display);
    font-size: var(--fs-500);
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--kerb-yellow);
    margin: 0 0 var(--sp-5);
    padding-bottom: var(--sp-3);
    border-bottom: 1px solid var(--asphalt-600);
  }

  .stats-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
    margin: 0;
  }

  .stats-list > div {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    border-bottom: 1px dashed var(--asphalt-600);
    padding-bottom: var(--sp-2);
  }

  .stats-list dt {
    font-size: var(--fs-300);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .stats-list dd {
    margin: 0;
    color: var(--text-primary);
    font-size: var(--fs-400);
  }

  .stats-list .badge {
    text-transform: uppercase;
    letter-spacing: 0.08em;
    font-size: var(--fs-200);
    background: var(--asphalt-900);
    border: 1px solid var(--asphalt-600);
    padding: 2px var(--sp-2);
    border-radius: var(--radius-sm);
    color: var(--kerb-yellow);
  }

  .lap-record {
    margin-top: var(--sp-5);
    padding-top: var(--sp-5);
    border-top: 1px solid var(--asphalt-600);
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-1) var(--sp-3);
    align-items: baseline;
  }

  .lr-eyebrow {
    grid-column: span 2;
    color: var(--kerb-yellow);
    font-size: var(--fs-200);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: var(--sp-1);
  }

  .lr-time {
    color: var(--text-primary);
    font-size: var(--fs-700);
    line-height: 1;
  }

  .lr-driver {
    color: var(--text-secondary);
    font-size: var(--fs-300);
    grid-column: 1 / 3;
  }

  .lr-year {
    color: var(--text-muted);
    font-size: var(--fs-200);
    letter-spacing: 0.12em;
    grid-column: 1 / 3;
  }

  @media (max-width: 720px) {
    .map-and-stats {
      grid-template-columns: 1fr;
    }
  }

  .long-form {
    padding-block: var(--sp-12);
    max-width: 720px;
  }

  .long-form :global(p) {
    color: var(--text-secondary);
    font-size: var(--fs-500);
    line-height: 1.7;
    margin-bottom: var(--sp-4);
  }

  .long-form :global(h2) {
    font-size: var(--fs-600);
    margin-block: var(--sp-8) var(--sp-3);
    border-left: 4px solid var(--kerb-yellow);
    padding-left: var(--sp-3);
  }

  .long-form :global(li) {
    margin-bottom: var(--sp-2);
    color: var(--text-secondary);
  }

  .long-form :global(strong) {
    color: var(--text-primary);
  }
</style>

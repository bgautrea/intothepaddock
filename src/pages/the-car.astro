---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/hero/Hero.astro';
import KerbDivider from '../components/ui/KerbDivider.astro';
import CarCutaway from '../components/hero/CarCutaway.astro';

const entry = await getEntry('topics', 'the-car');
if (!entry) throw new Error('Missing topics/the-car content entry');
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.subtitle}>
  <Hero eyebrow="Section 03" title={entry.data.title} subtitle={entry.data.subtitle}>
    <Fragment slot="visual">
      <CarCutaway />
    </Fragment>
  </Hero>

  <KerbDivider variant="thin" />

  <section class="container long-form">
    <Content />
  </section>
</BaseLayout>

<style>
  .long-form {
    padding-block: var(--sp-12);
    max-width: 760px;
  }

  .long-form :global(p) {
    color: var(--text-secondary);
    font-size: var(--fs-500);
    line-height: 1.7;
    margin-bottom: var(--sp-4);
  }

  .long-form :global(h2) {
    font-size: var(--fs-700);
    font-family: var(--font-display);
    color: var(--text-primary);
    margin-block: var(--sp-16) var(--sp-4);
    padding-bottom: var(--sp-3);
    border-bottom: 2px solid var(--kerb-yellow);
    scroll-margin-top: calc(var(--nav-height) + var(--sp-6));
  }

  .long-form :global(h2 a) {
    color: inherit;
    text-decoration: none;
  }

  .long-form :global(h2:first-of-type) {
    margin-top: var(--sp-12);
  }

  .long-form :global(blockquote) {
    margin: var(--sp-6) 0;
    padding: var(--sp-4) var(--sp-5);
    background: var(--asphalt-800);
    border: var(--border-thin);
    border-top: 3px solid var(--kerb-yellow);
    border-radius: var(--radius-sm);
  }

  .long-form :global(blockquote p) {
    margin: 0;
    color: var(--text-primary);
    font-size: var(--fs-400);
  }

  .long-form :global(strong) {
    color: var(--text-primary);
  }

  .long-form :global(ul) {
    color: var(--text-secondary);
    font-size: var(--fs-400);
    line-height: 1.7;
    padding-left: var(--sp-6);
    margin-bottom: var(--sp-4);
  }

  .long-form :global(li) {
    margin-bottom: var(--sp-2);
  }
</style>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/hero/Hero.astro';
import KerbDivider from '../components/ui/KerbDivider.astro';
---

<BaseLayout title="Rules & Regulations" description="Points, flags, penalties, parc fermé — without the rulebook tedium.">
  <Hero
    eyebrow="Section 05 · Coming in Milestone 4"
    title="Rules & Regulations"
    subtitle="Points, flags, penalties, parc fermé, technical regs. This page is on the way."
  />

  <KerbDivider variant="thin" />

  <section class="container placeholder">
    <p class="eyebrow">Status</p>
    <p>This page will land in the single-topic deep-dive milestone. The short version: 25 points for a win, 18 for second, scaling down to 10th. Yellow flag = caution. Red flag = race stopped.</p>
  </section>
</BaseLayout>

<style>
  .placeholder {
    padding-block: var(--sp-12);
    max-width: 720px;
  }

  .placeholder .eyebrow {
    margin-bottom: var(--sp-2);
  }

  .placeholder p {
    color: var(--text-secondary);
    font-size: var(--fs-500);
    line-height: 1.6;
  }
</style>

# Caddyfile for the intothepaddock static site.
# TLS is terminated upstream (k8s ingress + Cloudflare edge), so we serve plain HTTP.

{
  # Disable automatic HTTPS — handled by ingress/edge.
  auto_https off
  # Don't bind to admin port inside the container.
  admin off
}

:8080 {
  root * /usr/share/caddy
  file_server

  encode zstd gzip

  # SPA-style fallthrough is unnecessary — Astro emits a real 404 page.
  handle_errors {
    @404 expression {http.error.status_code} == 404
    rewrite @404 /404.html
    file_server
  }

  # Cache headers
  @hashed path_regexp \.[a-f0-9]{8,}\.(js|css|woff2|jpg|jpeg|png|svg|webp|avif)$
  header @hashed Cache-Control "public, max-age=31536000, immutable"

  @html path *.html /
  header @html Cache-Control "public, max-age=300, stale-while-revalidate=86400"

  header X-Content-Type-Options "nosniff"
  header Referrer-Policy "strict-origin-when-cross-origin"
  header X-Frame-Options "DENY"

  log {
    output stdout
    format console
  }
}
